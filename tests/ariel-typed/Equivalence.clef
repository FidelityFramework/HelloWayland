/// Real serial/worker byte-value equivalence with no display or raw pointers.
module TypedRendererEquivalence

let private check condition name =
    if condition then 0
    else
        Console.write "FAIL "
        Console.writeln name
        1

let private same (first: int array) (second: int array) : bool =
    let mutable agrees = Array.length first = Array.length second
    let mutable i = 0
    while i < Array.length first && agrees do
        agrees <- Array.get first i = Array.get second i
        i <- i + 1
    agrees

let private runCase (samples: int array) (modelCount: int)
                    (width: int) (height: int) (stride: int)
                    (bandY: int) (bandRows: int) (angle: int) (chunk: int)
                    (requireWorker: bool) : int =
    let length = height * stride
    let serial = Array.zeroCreate<int> length
    let concurrentPixels = Array.zeroCreate<int> length
    let mutable initialized = 0
    while initialized < length do
        Array.set serial initialized 324508639
        Array.set concurrentPixels initialized 324508639
        initialized <- initialized + 1
    let requiredTableElements = Common.Trace.tableSize modelCount
    let table = Array.zeroCreate<int> requiredTableElements
    Common.Trace.fillTable table samples modelCount stride height
        (width * 128) (height * 128)
        (Common.Fixed.cosSmall12 angle) (Common.Fixed.sinSmall12 angle)
        width 0 0 width height bandY bandRows (Common.Model.anchorCount ()) 1024 16
    let count = bandRows * stride
    let mutable i = 0
    while i < count do
        Array.set serial (bandY * stride + i) (Common.Trace.pixel i table count)
        i <- i + 1
    let rendered = TypedFill.frame table requiredTableElements concurrentPixels stride height chunk
    let mutable failed = check (rendered = 0) "parallel frame status"
    failed <- failed + check (same serial concurrentPixels) "serial/parallel pixels and untouched rows"
    let repeated = TypedFill.frame table requiredTableElements concurrentPixels stride height chunk
    failed <- failed + check (repeated = 0 && same serial concurrentPixels) "repeated region generation"
    if requireWorker then
        let witnessed = WorkerWitness.frame table requiredTableElements concurrentPixels stride height chunk
        failed <- failed + check (witnessed = 0 && same serial concurrentPixels) "noncaller rendered real pixels"
    else ()
    let prefix = Array.sub table 0 32
    let truncated = TypedFill.frame prefix requiredTableElements concurrentPixels stride height chunk
    failed <- failed + check (truncated <> 0 && same serial concurrentPixels) "missing indirect inputs rejected"
    Array.set table 17 (height + 1)
    let oversized = TypedFill.frame table requiredTableElements concurrentPixels stride height chunk
    failed <- failed + check (oversized <> 0 && same serial concurrentPixels) "invalid output band rejected"
    failed

let private runCarriers (samples: int array) (modelCount: int) (carriers: int) : int =
    let started = Fidelity.Ariel.Region.start carriers
    if started <> 0 then check false "start native carriers"
    else
    let mutable failed = 0
    failed <- failed + runCase samples modelCount 32 24 32 0 24 0 256 false
    failed <- failed + runCase samples modelCount 37 29 40 3 17 1072 113 false
    failed <- failed + runCase samples modelCount 48 31 51 1 29 (0 - 1072) 256 false
    failed <- failed + runCase samples modelCount 64 80 67 3 73 2145 251 (carriers > 1)
    failed <- failed + runCase samples modelCount 19 11 23 11 0 0 256 false
    failed <- failed + check (Fidelity.Ariel.Region.stop () = 0) "join native carriers"
    failed

[<EntryPoint>]
let main _ =
    let samples = Array.zeroCreate<int> 3072
    let modelCount = Common.Model.build samples
    if modelCount <= 3 then check false "real glyph model"
    else
    let mutable failed = runCarriers samples modelCount 1
    failed <- failed + runCarriers samples modelCount 2
    failed <- failed + runCarriers samples modelCount 4
    if failed = 0 then Console.writeln "typed serial/Ariel renderer equivalence: passed" else ()
    if failed = 0 then 0 else 1
