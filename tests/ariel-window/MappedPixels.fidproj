[package]
name = "HelloWayland.MappedPixels"
version = "0.1.0"

[compilation]
target = "cpu"

[dependencies]
platform = { path = "../../../Fidelity.Platform/CPU/Linux/x86_64/Fidelity.Platform.CompilerSurface.fidproj" }
gbm = { path = "../../../Fidelity.Platform/CPU/Linux/x86_64/Fidelity.GBM.Native.fidproj" }
display = { path = "../../../Fidelity.Platform/CPU/Linux/x86_64/Fidelity.Display.Native.fidproj" }

[build]
sources = ["MappedPixels.clef", "MappedPixels.Main.clef"]
output = "mapped-pixels"
output_kind = "console"
