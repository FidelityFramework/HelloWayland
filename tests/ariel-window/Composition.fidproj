[package]
name = "HelloWayland.WindowComposition"
version = "0.1.0"

[compilation]
target = "cpu"

[dependencies]
platform = { path = "../../../Fidelity.Platform/CPU/Linux/x86_64/Fidelity.Platform.CompilerSurface.fidproj" }
dispatch = { path = "../../../BAREWire/src/BAREWire.DispatchCore.fidproj" }

[build]
sources = [
    "../../src/Common/Fixed.clef",
    "../../src/Common/Geometry.clef",
    "../../src/Cpu/Typed/Trace.clef",
    "../../src/Cpu/Typed/Model.clef",
    "../../src/Cpu/Typed/Anim.clef",
    "../../src/Cpu/Typed/Layout.clef",
    "../../src/Cpu/Typed/Composition.clef",
    "Composition.clef"
]
output = "typed-window-composition"
output_kind = "console"
