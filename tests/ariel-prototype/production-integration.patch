     Connection.disconnect disp
     0
+
+/// Own the fill state outside the host's early-return paths. Region shutdown
+/// joins the persistent carriers before the containing state allocation is freed.
+let run (title: string) : int =
+    match Fidelity.Libc.Memory.malloc (unativeint 256) with
+    | None -> 1
+    | Some fillRaw ->
+        Fidelity.Libc.Memory.memset (Some fillRaw) 0 (unativeint 256) |> ignore
+        let result = runWithFill title fillRaw
+        let stopped = Fill.shutdown (NativePtr.ofNativeInt<nativeint> fillRaw)
+        if stopped = 0 then Fidelity.Libc.Memory.free (Some fillRaw) |> ignore else ()
+        if result <> 0 then result else stopped
