/// Common.Trace — THE renderer
///
/// One per-pixel ray tracer, compiled into both binaries from this file.
/// The CPU build walks it in a loop; the GPU build dispatches one thread
/// per pixel at it inside a gfx1151 code object. Neither has its own copy
/// and neither has its own shading model — a pixel is a pixel.
///
/// `pixel` is a pure function of (index, table, count): no buffers in the
/// signature beyond the shared read-only table, no state, no allocation.
/// That is what lets the identical definition cross to the device.
///
/// The split between `fillTable` and `pixel` is the coeffect boundary.
/// Anything a pixel would otherwise recompute identically for every pixel
/// — the rotation of a primitive, which primitives can possibly cover a
/// given tile — is *observed once* into the table and merely read in the
/// inner loop. That is what makes the same gather affordable on one CPU
/// core and on a whole GPU.
///
/// ---------------------------------------------------------------------
/// THE SURFACE MODEL
///
/// The glyph is a signed distance field evaluated in true 3D, and the
/// visible surface is its zero set. There are two CSG groups, split in
/// Model.clef and told apart here by index alone:
///
///   f(p) = smin( min over tube cones, min over anchor spheres, k )
///
/// Hard minimum *within* a group, smooth minimum *between* groups. A group
/// is one surface, so there is nothing inside it to fillet; the only real
/// crease in the glyph is where the tube emerges from the bulb, and that is
/// exactly where — and only where — smin acts.
///
/// This replaces a screen-space pass that averaged the normals of nearby
/// spheres inside a depth band. That average had no geometric referent: the
/// contributing normals were each taken at a *different* point in space, so
/// no surface had the normal it produced, and no amount of band tuning
/// could converge. Here every field and every gradient is evaluated at one
/// point p, which is what makes the result a surface rather than a blend.
///
/// Two consequences worth stating, because both delete code rather than
/// adding it:
///
///   The tube is round cones (tapered capsules) between consecutive
///   polyline points, not a dense chain of spheres. A cone *is* the
///   swept-sphere envelope, so its normal is continuous along the sweep.
///   Overlapping spheres are only C0: the normal jumps by the half-angle
///   between neighbours wherever the nearest one changes, and a ^72
///   specular lobe magnifies that into visible beading along the swoop.
///   Denser sampling shortens the beads without ever removing them.
///
///   The gradient is free. For f = smin(a, b, k), the partials collapse to
///   df/da = h and df/db = 1 - h, where h is smin's own interpolation
///   parameter. So grad f = h*ga + (1-h)*gb, and ga, gb are the unit
///   vectors from the two *winning* primitives — both already found. No
///   finite differences, no extra field evaluations.
///
/// Marching is not needed. Pass 1 solves ray-vs-sphere analytically for a
/// start point on the hard union, and two Newton steps along the ray move
/// it onto the smooth union. Measured against a 160-step sphere trace, two
/// steps differ on 3.1% of covered pixels by more than 8/255, and are
/// visually indistinguishable.
///
/// Table layout (int, Q8 unless noted):
///   [0]  stride in pixels     [1]  window height
///   [2]  point count          [3]  window width
///   [4]  rx0  [5] ry0  [6] rx1  [7] ry1     glyph rect (screen px)
///   [8]  tilesX               [9]  tilesY
///   [10] 65536 / tileSize     [11] primitive record base
///   [12] tile offset base     [13] tile item base
///   [14] logo scale k12       [15] used length
///   [16] band first row       [17] band row count
///   [18] 2^38 / stride        [19] anchor count
///   [20] origin x8            [21] origin y8
///   [22] max k / 4            [23] segment count
///   [24] shadow steps         [25] shadow list base
///   [26] shadow list stride   [27..31] spare
///   primitive records: 12 ints each
///       sx8 sy8 rp8   screen centre and radius — tile binning only
///       cx8 cy8 cz8   ROTATED, UNPROJECTED logo centre — the 3D field
///       r8  k8        logo radius, fillet radius
///       nx ny nz s12  body axis (Q12, world) and semi-axis scale along it
///   tile offsets:   tilesX*tilesY + 1 prefix sums into the item array
///   tile items:     segment indices, grouped by tile
///   shadow lists:   per anchor, a count then the segment indices that can
///                   stand between that anchor and the light
module Common.Trace

open Common.Fixed
open Common.Geometry

/// Grid ceiling: the glyph is a fixed pixel size, so 64x64 tiles is ample
/// at any window size, and the tile arrays can be sized once.
let private maxTiles () : int = 4096

/// Header ints. Was 24 and exactly full; the shadow pass needs three more
/// (step budget, list base, list stride) and round numbers are cheaper to
/// reason about than tight ones when a layout changes again.
let private hdrSize () : int = 32

/// Per-anchor shadow candidate capacity, and the anchor ceiling the table is
/// sized for. A candidate list is the tube segments that can stand between one
/// anchor and the light — the light-space analogue of a screen tile, built by
/// the same observe-once rule.
let private shadowCap () : int = 48
let private maxAnchors () : int = 8

/// The point light, Q8 logo units. Geometry.shadeNormal places it at logo
/// (0, 0, -75) and this must be the same source, or a point could be shaded as
/// lit by one light and occluded from another.
let private lightZ () : int = 0 - 19200

/// Camera and glyph axes in Q8 logo units. The eye sits at (PX, PY, -F)
/// looking down +z, and the projection plane is z = 0 — which is exactly
/// the perspective the projX8/projY8 divide already implements, so screen
/// space and this ray geometry describe the same camera.
let private camF () : int = 66560
let private camX () : int = 17423
let private camY () : int = 17152

/// Round-cone distance, value only.
///
/// The tracer's inner loop derives this alongside the gradient it also needs,
/// so it keeps its own copy; the shadow march wants the scalar and nothing
/// else. Same law and the same degenerate-taper fallback: when |dr| >= |b-a|
/// the swept envelope is just the larger endpoint sphere and the tangent
/// construction has no real root.
let private coneDist (px: int) (py: int) (pz: int)
                     (ax: int) (ay: int) (az: int) (r1: int)
                     (bax: int) (bay: int) (baz: int) (rr: int) : int =
    let l2 = bax * bax + bay * bay + baz * baz
    let pax = px - ax
    let pay = py - ay
    let paz = pz - az
    let yv = pax * bax + pay * bay + paz * baz
    let pa2 = pax * pax + pay * pay + paz * paz
    let aq = l2 - rr * rr
    let xq = l2 * pa2 - yv * yv
    let sq = if aq > 0 then (if xq > 0 then Fixed.isqrt (xq / aq) else 0) else 0
    let u0 =
        if aq > 0 then (if l2 > 0 then ((yv + rr * sq) * 4096) / l2 else 0)
        else (if rr > 0 then 4096 else 0)
    let u = Fixed.clamp u0 0 4096
    let dqx = px - (ax + (u * bax) / 4096)
    let dqy = py - (ay + (u * bay) / 4096)
    let dqz = pz - (az + (u * baz) / 4096)
    Fixed.isqrt (dqx * dqx + dqy * dqy + dqz * dqz) - (r1 + (u * rr) / 4096)

/// How many ints the shared table needs for a model of `count` points.
/// One definition, so the host and the device allocator cannot disagree.
let tableSize (count: int) : int =
    hdrSize () + count * 12 + (maxTiles () + 1) + count * 64
    + maxAnchors () * (shadowCap () + 1)

/// Pack the frame description the tracer reads: rotate every primitive
/// once, then bucket the tube segments into screen tiles. One definition,
/// so the two substrates cannot disagree about what a frame is.
let fillTable (table: int array) (samples: nativeptr<int32>) (count: int)
              (stridePx: int) (h: int) (ox8: int) (oy8: int)
              (ct: int) (st: int) (w: int)
              (rx0: int) (ry0: int) (rx1: int) (ry1: int)
              (bandY0: int) (bandRows: int) (nAnchor: int) (k12: int)
              (shadowSteps: int) : unit =
    let recBase = hdrSize ()
    let offsetBase = recBase + count * 12
    // The shadow lists sit BEFORE the item array, not after it. The GPU
    // uploads `used length` (slot 15) rather than the whole table, and that
    // watermark ends at itemBase + used — so anything past the item region is
    // never copied to the device. Placed after the items these lists reached
    // the CPU and not the kernel, which read zeros and skipped every march:
    // one binary with shadows, one without, from identical source.
    let shadowBase = offsetBase + maxTiles () + 1
    let itemBase = shadowBase + maxAnchors () * (shadowCap () + 1)
    let itemCap = count * 64
    let nSeg = if count > nAnchor then count - nAnchor - 1 else 0

    // The smooth minimum departs from the hard minimum by at most k/4, so
    // the blended surface can sit that far outside the union and nowhere
    // further. Every bound below is widened by exactly that much: the tile
    // bbox, so a pixel in the fillet is binned, and the pass-1 ray-sphere
    // radius, so it gets a start point. It is a derived quantity, not a
    // margin — there is nothing here to tune.
    let mutable kMax = 0
    let mutable q = 0
    while q < count do
        let kq = int (NativePtr.get samples (q * 6 + 3))
        if kq > kMax then kMax <- kq else ()
        q <- q + 1
    let kPad = kMax / 4

    // Tiles are a power of two wide so the pixel-side divide is a multiply.
    let rw = rx1 - rx0
    let rh = ry1 - ry0
    let mutable ts = 16
    while rw / ts >= 63 || rh / ts >= 63 do
        ts <- ts * 2
    let tilesX = rw / ts + 1
    let tilesY = rh / ts + 1
    let nTiles = tilesX * tilesY

    // Rotate each primitive once. Note the 3D centre is rotated but NOT
    // projected: perspective is in the ray, so applying it here as well
    // would divide the geometry twice. Only the screen triple carries the
    // projection, and it is used for nothing but tile binning.
    let mutable k = 0
    while k < count do
        let sx = int (NativePtr.get samples (k * 6 + 0))
        let sy = int (NativePtr.get samples (k * 6 + 1))
        let sr = int (NativePtr.get samples (k * 6 + 2))
        let sk = int (NativePtr.get samples (k * 6 + 3))
        let b = recBase + k * 12
        let rx = sx - camX ()
        Array.set table b (projX8 sx ct st ox8 k12)
        Array.set table (b + 1) (projY8 sx sy st oy8 k12)
        Array.set table (b + 2) (projR8 sx (sr + kPad) st k12)
        Array.set table (b + 3) (camX () + (rx * ct) / 4096)
        Array.set table (b + 4) sy
        Array.set table (b + 5) ((rx * st) / 4096)
        Array.set table (b + 6) sr
        Array.set table (b + 7) sk
        // The body's own axis, carried into world space through the same pivot
        // the positions take. A sphere stores an isotropic scale and the axis
        // is then irrelevant — the field below degenerates to |p-c|-r exactly.
        let sc = int (NativePtr.get samples (k * 6 + 4))
        let tl = int (NativePtr.get samples (k * 6 + 5))
        let ctT = Fixed.cosSmall12 tl
        let stT = Fixed.sinSmall12 tl
        Array.set table (b + 8) ((st * ctT) / 4096)
        Array.set table (b + 9) stT
        Array.set table (b + 10) ((ct * ctT) / 4096)
        Array.set table (b + 11) sc
        k <- k + 1

    // --- light-space candidate lists, one per anchor --------------------
    //
    // The screen tiles below answer "which segments can this pixel see". The
    // same question with the eye replaced by the light answers "which segments
    // can shadow this anchor", and it is worth answering once per frame rather
    // than once per shaded point — the anchors are three fixed bodies, so the
    // whole structure is three short lists and it is built by the same
    // observe-once rule the tile grid is.
    //
    // The frustum from a sphere of radius R to a point light is a cone that
    // narrows to nothing at the light, so a CYLINDER of radius R about the
    // same axis contains it. That makes the test one dot product and one
    // comparison per segment, and conservative everywhere rather than only
    // near the anchor.
    Array.set table 24 shadowSteps
    Array.set table 25 shadowBase
    Array.set table 26 (shadowCap () + 1)
    let mutable an = 0
    while an < nAnchor do
        let ab = recBase + an * 12
        let acx = Array.get table (ab + 3)
        let acy = Array.get table (ab + 4)
        let acz = Array.get table (ab + 5)
        let acr = Array.get table (ab + 6)
        let hx = 0 - acx
        let hy = 0 - acy
        let hz = lightZ () - acz
        let hl = Fixed.isqrt (hx * hx + hy * hy + hz * hz)
        let ux = if hl > 0 then (hx * 4096) / hl else 0
        let uy = if hl > 0 then (hy * 4096) / hl else 0
        let uz = if hl > 0 then (hz * 4096) / hl else 0 - 4096
        let lb = shadowBase + an * (shadowCap () + 1)
        let mutable nc = 0
        let mutable sg = 0
        while sg < nSeg do
            let eb = recBase + (nAnchor + sg) * 12
            let e0x = Array.get table (eb + 3)
            let e0y = Array.get table (eb + 4)
            let e0z = Array.get table (eb + 5)
            let r0 = Array.get table (eb + 6)
            let e1x = Array.get table (eb + 15)
            let e1y = Array.get table (eb + 16)
            let e1z = Array.get table (eb + 17)
            let r1s = Array.get table (eb + 18)
            let mx = (e0x + e1x) / 2
            let my = (e0y + e1y) / 2
            let mz = (e0z + e1z) / 2
            let hdx = (e1x - e0x) / 2
            let hdy = (e1y - e0y) / 2
            let hdz = (e1z - e0z) / 2
            let mr = Fixed.isqrt (hdx * hdx + hdy * hdy + hdz * hdz)
                     + (if r0 > r1s then r0 else r1s)
            // A body is not shadowed by geometry it is FUSED to. The chain's
            // first spans sit up to 30 logo units INSIDE the bulb, so counting
            // them as occluders makes the join shadow itself — a hard crease
            // across the bulb, and static at every pivot angle, because it was
            // never a cast shadow. Overlapping within the fillet radius means
            // one surface, and a surface casts no shadow on itself. Measured:
            // this drops 38 of 121 segments for the bulb and none at all for
            // the dots, whose eclipse is unchanged to the digit.
            let ak = Array.get table (ab + 7)
            let g0x = e0x - acx
            let g0y = e0y - acy
            let g0z = e0z - acz
            let g1x = e1x - acx
            let g1y = e1y - acy
            let g1z = e1z - acz
            let gp0 = Fixed.isqrt (g0x * g0x + g0y * g0y + g0z * g0z) - r0 - acr
            let gp1 = Fixed.isqrt (g1x * g1x + g1y * g1y + g1z * g1z) - r1s - acr
            let gap = if gp0 < gp1 then gp0 else gp1
            let wx = mx - acx
            let wy = my - acy
            let wz = mz - acz
            let pr = (wx * ux + wy * uy + wz * uz) / 4096
            if gap > ak && pr > 0 && pr < hl && nc < shadowCap () then
                let perp2 = wx * wx + wy * wy + wz * wz - pr * pr
                let lim = acr + mr
                if perp2 < lim * lim then
                    Array.set table (lb + 1 + nc) sg
                    nc <- nc + 1
                else ()
            else ()
            sg <- sg + 1
        Array.set table lb nc
        an <- an + 1

    // Pass 1: how many segments land in each tile. Counts are written one
    // slot high so the prefix sum below turns them into start offsets in
    // place, without a second array. A segment's screen extent is the union
    // of its two endpoint discs — the cone between them lies inside their
    // convex hull, so that bound is sound.
    let mutable t = 0
    while t <= nTiles do
        Array.set table (offsetBase + t) 0
        t <- t + 1
    let mutable s = 0
    while s < nSeg do
        let ba = recBase + (nAnchor + s) * 12
        let bb = ba + 12
        let ax = Array.get table ba / 256
        let ay = Array.get table (ba + 1) / 256
        let ar = Array.get table (ba + 2) / 256 + 1
        let bx = Array.get table bb / 256
        let by = Array.get table (bb + 1) / 256
        let br = Array.get table (bb + 2) / 256 + 1
        let lo0 = if ax - ar < bx - br then ax - ar else bx - br
        let hi0 = if ax + ar > bx + br then ax + ar else bx + br
        let lo1 = if ay - ar < by - br then ay - ar else by - br
        let hi1 = if ay + ar > by + br then ay + ar else by + br
        let tx0 = Fixed.clamp ((lo0 - rx0) / ts) 0 (tilesX - 1)
        let tx1 = Fixed.clamp ((hi0 - rx0) / ts) 0 (tilesX - 1)
        let ty0 = Fixed.clamp ((lo1 - ry0) / ts) 0 (tilesY - 1)
        let ty1 = Fixed.clamp ((hi1 - ry0) / ts) 0 (tilesY - 1)
        let mutable ty = ty0
        while ty <= ty1 do
            let mutable tx = tx0
            while tx <= tx1 do
                let sl = offsetBase + ty * tilesX + tx + 1
                Array.set table sl (Array.get table sl + 1)
                tx <- tx + 1
            ty <- ty + 1
        s <- s + 1

    // Prefix sum: slot[t] becomes tile t's start, slot[t+1] its end.
    // Saturating, so a pathological model truncates rather than overruns.
    t <- 1
    while t <= nTiles do
        let sl = offsetBase + t
        let v = Array.get table (offsetBase + t - 1) + Array.get table sl
        Array.set table sl (if v > itemCap then itemCap else v)
        t <- t + 1
    let used = Array.get table (offsetBase + nTiles)

    // Pass 2: scatter, using each start offset as a cursor.
    s <- 0
    while s < nSeg do
        let ba = recBase + (nAnchor + s) * 12
        let bb = ba + 12
        let ax = Array.get table ba / 256
        let ay = Array.get table (ba + 1) / 256
        let ar = Array.get table (ba + 2) / 256 + 1
        let bx = Array.get table bb / 256
        let by = Array.get table (bb + 1) / 256
        let br = Array.get table (bb + 2) / 256 + 1
        let lo0 = if ax - ar < bx - br then ax - ar else bx - br
        let hi0 = if ax + ar > bx + br then ax + ar else bx + br
        let lo1 = if ay - ar < by - br then ay - ar else by - br
        let hi1 = if ay + ar > by + br then ay + ar else by + br
        let tx0 = Fixed.clamp ((lo0 - rx0) / ts) 0 (tilesX - 1)
        let tx1 = Fixed.clamp ((hi0 - rx0) / ts) 0 (tilesX - 1)
        let ty0 = Fixed.clamp ((lo1 - ry0) / ts) 0 (tilesY - 1)
        let ty1 = Fixed.clamp ((hi1 - ry0) / ts) 0 (tilesY - 1)
        let mutable ty = ty0
        while ty <= ty1 do
            let mutable tx = tx0
            while tx <= tx1 do
                let sl = offsetBase + ty * tilesX + tx
                let cur = Array.get table sl
                if cur < Array.get table (sl + 1) then
                    Array.set table (itemBase + cur) s
                    Array.set table sl (cur + 1)
                else ()
                tx <- tx + 1
            ty <- ty + 1
        s <- s + 1

    // Each cursor now holds its tile's end. Shifting the array up one slot
    // restores starts, because tile t's start is tile t-1's end.
    t <- nTiles
    while t > 0 do
        Array.set table (offsetBase + t) (Array.get table (offsetBase + t - 1))
        t <- t - 1
    Array.set table offsetBase 0
    Array.set table (offsetBase + nTiles) used

    // Order each tile front-to-back. Sorting here — once per tile per frame
    // — is what lets the depth bound in pass 1 reject candidates before any
    // square root happens, on either substrate. The key is the nearest
    // point of the segment in z.
    t <- 0
    while t < nTiles do
        let s0 = Array.get table (offsetBase + t)
        let e0 = Array.get table (offsetBase + t + 1)
        let mutable p = s0 + 1
        while p < e0 do
            let v = Array.get table (itemBase + p)
            let vb = recBase + (nAnchor + v) * 12
            let vz0 = Array.get table (vb + 5) - Array.get table (vb + 6)
            let vz1 = Array.get table (vb + 17) - Array.get table (vb + 18)
            let vz = if vz0 < vz1 then vz0 else vz1
            let mutable qq = p
            let mutable sinking = 1
            while sinking = 1 do
                if qq > s0 then
                    let pv = Array.get table (itemBase + qq - 1)
                    let pb = recBase + (nAnchor + pv) * 12
                    let pz0 = Array.get table (pb + 5) - Array.get table (pb + 6)
                    let pz1 = Array.get table (pb + 17) - Array.get table (pb + 18)
                    let pz = if pz0 < pz1 then pz0 else pz1
                    if pz > vz then
                        Array.set table (itemBase + qq) pv
                        qq <- qq - 1
                    else sinking <- 0
                else sinking <- 0
            Array.set table (itemBase + qq) v
            p <- p + 1
        t <- t + 1

    Array.set table 0 stridePx
    Array.set table 1 h
    Array.set table 2 count
    Array.set table 3 w
    Array.set table 4 rx0
    Array.set table 5 ry0
    Array.set table 6 rx1
    Array.set table 7 ry1
    Array.set table 8 tilesX
    Array.set table 9 tilesY
    Array.set table 10 (65536 / ts)
    Array.set table 11 recBase
    Array.set table 12 offsetBase
    Array.set table 13 itemBase
    Array.set table 14 k12
    Array.set table 15 (itemBase + used)
    Array.set table 16 bandY0
    Array.set table 17 bandRows
    // Row and column from one multiply instead of two divides: 2^38 is
    // exact for any stride and index this shell can produce.
    Array.set table 18 ((524288 * 524288) / stridePx + 1)
    Array.set table 19 nAnchor
    Array.set table 20 ox8
    Array.set table 21 oy8
    Array.set table 22 kPad
    Array.set table 23 nSeg

/// The value `pixel` returns where the ray misses the glyph. A Fill that has
/// a backdrop to preserve tests against this and leaves those pixels alone,
/// which is what makes the logo composite over the chrome rather than
/// painting a black rectangle across it.
let background () : int = 16777216 * 255

/// Shade one pixel of the frame the table describes.
let pixel (i: int) (data: int array) (n: int) : int =
    if i >= n then 0
    else
    let stridePx = Array.get data 0
    let w = Array.get data 3
    // The domain is a band of rows, not the whole window: outside the band
    // the frame is unchanged from the full paint the shell did when the
    // swapchain was built, so there is nothing to recompute.
    let row = ((i * Array.get data 18) / 524288) / 524288
    let gx = i - row * stridePx
    let gy = Array.get data 16 + row
    // Flat black backdrop. The glyph is matte and lit from one side, so its
    // silhouette falls to near-black at every grazing edge; over a blue
    // gradient that rim read as a dirty fringe, and over black it reads as
    // form. Being a constant it also costs nothing.
    let bg = background ()
    if gx >= w then bg
    else
    let rx0 = Array.get data 4
    let ry0 = Array.get data 5
    let rx1 = Array.get data 6
    let ry1 = Array.get data 7
    let inside = if gx >= rx0 then (if gx < rx1 then (if gy >= ry0 then (if gy < ry1 then 1 else 0) else 0) else 0) else 0
    if inside = 0 then bg
    else
    // Which tile this pixel belongs to, and hence which segments can
    // possibly cover it. Everything else is already excluded.
    let recip = Array.get data 10
    let tx = ((gx - rx0) * recip) / 65536
    let ty = ((gy - ry0) * recip) / 65536
    let ob = Array.get data 12
    let ti = ob + ty * Array.get data 8 + tx
    let first = Array.get data ti
    let last = Array.get data (ti + 1)
    let ib = Array.get data 13
    let sb = Array.get data 11
    let nAnchor = Array.get data 19
    let kPad = Array.get data 22

    // The view ray. Undo the logo-unit -> screen scale to land on the
    // projection plane z = 0, then aim from the eye through that point.
    // Perspective is entirely in this construction, which is why the table
    // stores unprojected 3D centres.
    let k12 = Array.get data 14
    let lx8 = ((gx * 256 - Array.get data 20) * 4096) / k12
    let ly8 = ((gy * 256 - Array.get data 21) * 4096) / k12
    let ex = camX ()
    let ey = camY ()
    let ez = 0 - camF ()
    let rdx = lx8 - ex
    let rdy = ly8 - ey
    let rdz = camF ()
    // Q20, not the Q12 used everywhere else. The eye sits 66560 Q8 units off
    // the projection plane, so a direction quantised to 1/4096 carries a
    // 16-unit error into the ray-sphere discriminant's linear term. Near a
    // silhouette the discriminant is itself only ~1e6, so that error flips
    // the hit test between neighbouring rays and shreds the edge into a
    // stipple about ten pixels deep. Sixteen bits of direction is not a
    // refinement here, it is the difference between a silhouette and a
    // dither. The products stay well inside int64: |oc| * 2^20 * 3 ~ 2.7e11.
    let rl = Fixed.isqrt (rdx * rdx + rdy * rdy + rdz * rdz)
    let dux = if rl > 0 then (rdx * 1048576) / rl else 0
    let duy = if rl > 0 then (rdy * 1048576) / rl else 0
    let duz = if rl > 0 then (rdz * 1048576) / rl else 1048576

    // Pass 1: nearest analytic ray-sphere hit, over the anchors and over
    // both endpoints of every segment in this tile. The endpoints overlap
    // by construction (Model spaces them below the local radius), so a ray
    // that clips only the conical flank still hits one of them — which is
    // what lets a ray-sphere test stand in for a ray-cone test here.
    let mutable tBest = 0
    let mutable found = 0
    // Whether the ray met a primitive at its TRUE radius, not merely at the
    // k/4-expanded one. That distinction is the coverage test: inside the
    // hard union there is certainly a surface, so the pixel is shaded
    // whatever the Newton residual came out as. Only the sliver between the
    // true and expanded radii — where the fillet may or may not have placed
    // a surface — has to justify itself by converging.
    let mutable foundHard = 0
    let mutable pass = 0
    while pass < 2 do
        // pass 0 walks the anchors, pass 1 walks this tile's segments; both
        // run the same intersection, so it is written once.
        let lo = if pass = 0 then 0 else first
        let hi = if pass = 0 then nAnchor else last
        let mutable j = lo
        while j < hi do
            let cnt = if pass = 0 then 1 else 2
            let mutable e = 0
            while e < cnt do
                let b =
                    if pass = 0 then sb + j * 12
                    else sb + (nAnchor + (Array.get data (ib + j)) + e) * 12
                let cz = Array.get data (b + 5)
                let rad = Array.get data (b + 6) + kPad
                // A primitive cannot be hit nearer than its own front face,
                // and the ray leans away from the axis, so this bound is
                // conservative. One compare, no square root.
                let bound = cz - rad + camF ()
                let skip = if found = 1 then (if bound >= tBest then 1 else 0) else 0
                if skip = 0 then
                    let ocx = ex - Array.get data (b + 3)
                    let ocy = ey - Array.get data (b + 4)
                    let ocz = ez - cz
                    let bq = (ocx * dux + ocy * duy + ocz * duz) / 1048576
                    let oc2 = ocx * ocx + ocy * ocy + ocz * ocz
                    let disc = bq * bq - (oc2 - rad * rad)
                    if disc > 0 then
                        let th = (0 - bq) - Fixed.isqrt disc
                        if th > 0 then
                            if found = 0 then
                                tBest <- th
                                found <- 1
                            else
                                if th < tBest then tBest <- th else ()
                            // The same intersection at the unexpanded radius
                            // — a compare and a multiply, no second root.
                            let rt = Array.get data (b + 6)
                            if bq * bq - (oc2 - rt * rt) > 0 then foundHard <- 1 else ()
                        else ()
                    else ()
                else ()
                e <- e + 1
            j <- j + 1
        pass <- pass + 1
    if found = 0 then bg
    else

    // Two Newton steps onto the smooth-union isosurface, then shade with
    // the gradient at the point we landed on. Three field evaluations in
    // all: the loop refines t on the first two and keeps the third's
    // gradient.
    let mutable t = tBest
    // Which anchor owns the point, and how much of it the anchor owns.
    // The shadow march needs both: the first picks the candidate list, the
    // second fades the result out across the fillet into the tube, which
    // does not receive at this budget.
    let mutable awOut = 0
    let mutable hvOut = 4096
    let mutable fval = 0
    let mutable fgx = 0
    let mutable fgy = 0
    let mutable fgz = 4096
    let mutable pxp = 0
    let mutable pyp = 0
    let mutable pzp = 0
    let mutable iter = 0
    while iter < 3 do
        let px = ex + (t * dux) / 1048576
        let py = ey + (t * duy) / 1048576
        let pz = ez + (t * duz) / 1048576

        // --- tube group: hard minimum over round cones ------------------
        // For segment a->b with radii r1->r2, the touching sphere's centre
        // is at parameter u along the axis:
        //     u = (y + rr*sqrt(X/A)) / l2
        // with y = pa.ba, X = l2*|pa|^2 - y^2, A = l2 - rr^2. Clamping u to
        // [0,1] folds in the spherical end caps, and A > 0 is exactly the
        // tangent-cone condition |dr/ds| < 1. The distance is then just
        // |p - q| - r(u), and the normal is the touching sphere's own —
        // which is what an envelope normal is.
        let mutable aBest = 1073741824
        let mutable gax = 0
        let mutable gay = 0
        let mutable gaz = 4096
        let mutable m = first
        while m < last do
            let ra = sb + (nAnchor + (Array.get data (ib + m))) * 12
            let ax = Array.get data (ra + 3)
            let ay = Array.get data (ra + 4)
            let az = Array.get data (ra + 5)
            let r1 = Array.get data (ra + 6)
            let bax = Array.get data (ra + 15) - ax
            let bay = Array.get data (ra + 16) - ay
            let baz = Array.get data (ra + 17) - az
            let rr = Array.get data (ra + 18) - r1
            let l2 = bax * bax + bay * bay + baz * baz
            let pax = px - ax
            let pay = py - ay
            let paz = pz - az
            let yv = pax * bax + pay * bay + paz * baz
            let pa2 = pax * pax + pay * pay + paz * paz
            let aq = l2 - rr * rr
            let xq = l2 * pa2 - yv * yv
            // A <= 0 is the tangent cone degenerating: the radius changes
            // faster along the segment than the segment is long, so one end
            // sphere entirely swallows the other and the swept family has no
            // envelope. The union is then just the larger sphere, which u at
            // the corresponding endpoint expresses exactly. The chain really
            // does this — it tapers 1560 -> 179 over 1177 units, |dr/ds| =
            // 1.17 — and no amount of subdivision changes it, because it is a
            // property of the curve and not of the sampling. Falling through
            // to the capsule formula here instead undersizes the surface, and
            // punched a comb of holes across the top of the arc.
            let sq = if aq > 0 then (if xq > 0 then Fixed.isqrt (xq / aq) else 0) else 0
            let u0 =
                if aq > 0 then (if l2 > 0 then ((yv + rr * sq) * 4096) / l2 else 0)
                else (if rr > 0 then 4096 else 0)
            let u = Fixed.clamp u0 0 4096
            let dqx = px - (ax + (u * bax) / 4096)
            let dqy = py - (ay + (u * bay) / 4096)
            let dqz = pz - (az + (u * baz) / 4096)
            let dl = Fixed.isqrt (dqx * dqx + dqy * dqy + dqz * dqz)
            let dv = dl - (r1 + (u * rr) / 4096)
            if dv < aBest then
                aBest <- dv
                gax <- if dl > 0 then (dqx * 4096) / dl else 0
                gay <- if dl > 0 then (dqy * 4096) / dl else 0
                gaz <- if dl > 0 then (dqz * 4096) / dl else 4096
            else ()
            m <- m + 1

        // --- anchor group: hard minimum over whole spheres ---------------
        // Three of them, so there is nothing to tile. The winner's k is the
        // fillet radius for this pixel: k belongs to the junction, and the
        // junction is owned by the anchor.
        let mutable bBest = 1073741824
        let mutable gbx = 0
        let mutable gby = 0
        let mutable gbz = 4096
        let mutable kw = 0
        let mutable aw = 0
        let mutable ai = 0
        while ai < nAnchor do
            let rc = sb + ai * 12
            let vx = px - Array.get data (rc + 3)
            let vy = py - Array.get data (rc + 4)
            let vz = pz - Array.get data (rc + 5)
            let ar = Array.get data (rc + 6)
            let nx = Array.get data (rc + 8)
            let ny = Array.get data (rc + 9)
            let nz = Array.get data (rc + 10)
            let sc = Array.get data (rc + 11)
            // An ellipsoid is a sphere under a rotor and a scale: stretch the
            // component along the body axis by 1/s and the sphere field applies.
            // f12 = 1/s - 1 in Q12, so f12 = 0 leaves v untouched and the whole
            // block reduces to |p-c|-r exactly — the isotropic case is not an
            // approximation of the sphere, it IS the sphere.
            let f12 = if sc > 0 then (4096 * 4096) / sc - 4096 else 0
            let vn = (vx * nx + vy * ny + vz * nz) / 4096
            let sh = (f12 * vn) / 4096
            let qx = vx + (sh * nx) / 4096
            let qy = vy + (sh * ny) / 4096
            let qz = vz + (sh * nz) / 4096
            let ql = Fixed.isqrt (qx * qx + qy * qy + qz * qz)
            // scale back by the smallest semi-axis so the result stays a
            // conservative distance bound, which is what the marcher needs
            let smin12 = if sc < 4096 then sc else 4096
            let dv = ((ql - ar) * smin12) / 4096
            if dv < bBest then
                bBest <- dv
                kw <- Array.get data (rc + 7)
                aw <- ai
                // grad|q| = qhat + (1/s - 1)(qhat . n) n, then renormalised
                let ux = if ql > 0 then (qx * 4096) / ql else 0
                let uy = if ql > 0 then (qy * 4096) / ql else 0
                let uz = if ql > 0 then (qz * 4096) / ql else 4096
                let un = (ux * nx + uy * ny + uz * nz) / 4096
                let gs = (f12 * un) / 4096
                let ex = ux + (gs * nx) / 4096
                let ey = uy + (gs * ny) / 4096
                let ez = uz + (gs * nz) / 4096
                let el = Fixed.isqrt (ex * ex + ey * ey + ez * ez)
                gbx <- if el > 0 then (ex * 4096) / el else 0
                gby <- if el > 0 then (ey * 4096) / el else 0
                gbz <- if el > 0 then (ez * 4096) / el else 4096
            else ()
            ai <- ai + 1

        // --- smooth union between the groups ----------------------------
        // hv is smin's own interpolation parameter, and df/da = hv exactly,
        // so the same number weights the value and the gradient. Fixed.smin
        // stays the single definition of the blend law.
        let hv =
            if kw > 0 then Fixed.clamp (2048 + (2048 * (bBest - aBest)) / kw) 0 4096
            else (if aBest < bBest then 4096 else 0)
        hvOut <- hv
        awOut <- aw
        fval <- Fixed.smin aBest bBest kw
        fgx <- (hv * gax + (4096 - hv) * gbx) / 4096
        fgy <- (hv * gay + (4096 - hv) * gby) / 4096
        fgz <- (hv * gaz + (4096 - hv) * gbz) / 4096
        pxp <- px
        pyp <- py
        pzp <- pz
        if iter < 2 then
            // df/dt = grad f . d, exact, because grad f is exact.
            //
            // The step is clamped because den is the cosine between the
            // surface normal and the ray, and it goes to zero at grazing
            // incidence — along every silhouette and across the tube's dark
            // flank. There f/den diverges and two iterations cannot recover,
            // which punched dithered holes in exactly those regions. The
            // bound is the model's own: the start point is on a sphere
            // inflated by k/4 and the true surface lies within k/4 of the
            // hard union, so no honest correction exceeds k/2.
            let den = (fgx * dux + fgy * duy + fgz * duz) / 1048576
            let lim = kPad * 2
            if den > 16 then t <- t - Fixed.clamp ((fval * 4096) / den) (0 - lim) lim
            else if den < (0 - 16) then t <- t - Fixed.clamp ((fval * 4096) / den) (0 - lim) lim
            else ()
        else ()
        iter <- iter + 1

    // Coverage is decided by the hard union, not by the residual. A ray that
    // entered a primitive at its true radius has hit the glyph, full stop.
    // Only a ray binned solely for the k/4 sliver has to show that the
    // fillet actually placed a surface in front of it.
    // The tolerance is absolute and tight, because a converged root really is
    // near zero — the offline reference settles inside ~6 of these units. It
    // cannot be scaled to the fillet: k/4 is 450 here, while the stroke over
    // the top of the arc has a radius of only 179, so a tolerance in that
    // neighbourhood accepts rays that miss the glyph entirely and paints a
    // fat speckled halo around the thinnest part of the swoop.
    let reject = if foundHard = 1 then 0 else (if fval > 24 then 1 else 0)
    if reject = 1 then bg
    else
    let gl = Fixed.isqrt (fgx * fgx + fgy * fgy + fgz * fgz)
    let sx = if gl > 0 then (fgx * 4096) / gl else 0
    let sy = if gl > 0 then (fgy * 4096) / gl else 0
    let sz = if gl > 0 then (fgz * 4096) / gl else 4096
    // The field's gradient points out of the solid, so at the front surface
    // it points back toward the eye at -z. shadeNormal's convention is the
    // opposite: nz > 0 faces the viewer.
    // --- shadow -------------------------------------------------------
    //
    // March toward the light over this anchor's candidate list. Same field,
    // same primitives, same arithmetic as the primary ray — the only thing
    // the substrate chooses is how many steps it can afford, read from the
    // table. The CPU marches coarse and the GPU marches fine; neither has a
    // different shading model, which is the property worth keeping.
    //
    // Penumbra comes free: the running minimum of d/t over the march is the
    // half-angle the occluder subtends from the point, so the same loop that
    // answers "is it blocked" also answers "by how much".
    let stepsB = Array.get data 24
    let mutable sfac = 4096
    if stepsB > 0 && hvOut < 4096 then
        let lb = Array.get data 25 + awOut * Array.get data 26
        let nc = Array.get data lb
        let tox = 0 - pxp
        let toy = 0 - pyp
        let toz = lightZ () - pzp
        let tl = Fixed.isqrt (tox * tox + toy * toy + toz * toz)
        let sdx = if tl > 0 then (tox * 4096) / tl else 0
        let sdy = if tl > 0 then (toy * 4096) / tl else 0
        let sdz = if tl > 0 then (toz * 4096) / tl else 0 - 4096
        // Start off the surface by more than the field's own tolerance, or
        // the point shadows itself and every lit body turns black.
        let mutable ts = 64
        let mutable st = 0
        while st < stepsB && sfac > 0 && ts < tl do
            let qx = pxp + (ts * sdx) / 4096
            let qy = pyp + (ts * sdy) / 4096
            let qz = pzp + (ts * sdz) / 4096
            let mutable dmin = 1073741824
            let mutable ci = 0
            while ci < nc do
                let sgi = Array.get data (lb + 1 + ci)
                let eb = sb + (nAnchor + sgi) * 12
                let eax = Array.get data (eb + 3)
                let eay = Array.get data (eb + 4)
                let eaz = Array.get data (eb + 5)
                let er0 = Array.get data (eb + 6)
                let dc = coneDist qx qy qz eax eay eaz er0
                                  (Array.get data (eb + 15) - eax)
                                  (Array.get data (eb + 16) - eay)
                                  (Array.get data (eb + 17) - eaz)
                                  (er0 - Array.get data (eb + 18))
                if dc < dmin then dmin <- dc else ()
                ci <- ci + 1
            if dmin < 16 then sfac <- 0
            else
                let rat = (dmin * 8 * 4096) / ts
                if rat < sfac then sfac <- rat else ()
                ts <- ts + dmin
            st <- st + 1
    else ()
    // Only the anchor's share of the point is shadowed, so where the tube
    // owns it the factor is 1 and the fillet fades between the two. The
    // ambient floor lives in shadeNormal, which is the only place that knows
    // which part of the colour came from the key light.
    let eff = 4096 - ((4096 - hvOut) * (4096 - sfac)) / 4096
    let c = shadeNormal sx sy (0 - sz) pxp pyp pzp eff
    // shadeNormal packs 0xRRGGBB; the surface wants ABGR8888 (byte 0 = R)
    let r = c / 65536
    let g = (c / 256) % 256
    let b = c % 256
    16777216 * 255 + b * 65536 + g * 256 + r
