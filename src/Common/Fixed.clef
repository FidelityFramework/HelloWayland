/// Common.Fixed — integer fixed-point math primitives
///
/// The Fidelity toolchain has no libm binding and float lowering is
/// unproven end-to-end, so everything here is integer fixed-point:
/// Q8 (1/256) for coordinates and distances, Q12 (1/4096) for
/// unit-scale values (radians, trig, normals, blend weights).
/// Division by a power of two stands in for arithmetic shifts
/// (shift operators are not in the proven Composer intrinsic set).
module Common.Fixed

/// Clamp v into [lo, hi].
let clamp (v: int) (lo: int) (hi: int) : int =
    if v < lo then lo
    else if v > hi then hi
    else v

/// Linear interpolation from a to b by t8 in Q8 (0..256).
let lerp8 (a: int) (b: int) (t8: int) : int =
    a + ((b - a) * t8) / 256

/// Integer square root (floor) via Newton iteration. n >= 0.
/// Polynomial smooth minimum over a window k.
///
/// Where a and b are further apart than k this is exactly min. Where they
/// are close it dips *below* both, most at a = b, by k/4. That dip is the
/// whole point: folding surface depths with this instead of min turns the
/// crease where two surfaces meet into a fillet, because material is added
/// in the valley and the term decays to nothing outside the window — so a
/// join can be rounded without the surfaces bulging anywhere else.
let smin (a: int) (b: int) (k: int) : int =
    if k <= 0 then (if a < b then a else b)
    else
        let h = clamp (2048 + (2048 * (b - a)) / k) 0 4096
        let m = b + ((a - b) * h) / 4096
        m - (k * h * (4096 - h)) / 16777216

/// Square root, seeded then refined a fixed four times. This is called
/// several times per candidate primitive per pixel, so the iteration count
/// is the tracer's inner cost: an open Newton loop from x = n takes a
/// division per halving (a dozen for a Q24 argument), whereas a seed within
/// a factor of two converges to integer precision in four.
///
/// The ladder runs to 2^36 because the tracer works in true 3D. The camera
/// sits 66560 Q8 logo units off the projection plane, so |p - eye|^2 for a
/// point anywhere on the glyph reaches ~1.4e10 — three rungs past where a
/// screen-space tracer ever had to go. A seed that is too small does not
/// fail loudly; four Newton steps from 8192 leave sqrt(1.4e10) short by a
/// factor of three, which reads as geometry in the wrong place rather than
/// as an error.
let isqrt (n: int) : int =
    if n <= 0 then 0
    else
        let mutable y = 4
        if n > 16 then y <- 8 else ()
        if n > 256 then y <- 32 else ()
        if n > 4096 then y <- 128 else ()
        if n > 65536 then y <- 512 else ()
        if n > 1048576 then y <- 2048 else ()
        if n > 16777216 then y <- 8192 else ()
        if n > 268435456 then y <- 32768 else ()
        // 2^32 and 2^36 as products: a literal wider than int32 wraps to
        // zero here, and a zero threshold fires for every argument — which
        // silently seeds small square roots from the top rung and returns
        // them 3x too large. Same idiom as the 2^38 constant in Trace.
        if n > (65536 * 65536) then y <- 131072 else ()
        if n > (262144 * 262144) then y <- 524288 else ()
        y <- (y + n / y) / 2
        y <- (y + n / y) / 2
        y <- (y + n / y) / 2
        y <- (y + n / y) / 2
        if y * y > n then y - 1 else y

/// Smoothstep t*t*(3 - 2t) in Q8: input 0..256, output 0..256.
/// Ease-in-out for the pivot oscillation (zero velocity at extremes).
let smoothstep8 (t8: int) : int =
    let t2 = t8 * t8
    (t2 * (768 - 2 * t8)) / 65536

/// Smoothstep in Q10 (input 0..1024, output 0..1024) — finer easing
/// steps for per-millisecond animation phases. Staged to stay in int32:
/// t2 <= 1024 after rescale, product <= 1024 * 3072.
let smoothstep10 (t10: int) : int =
    let t2 = (t10 * t10) / 1024
    (t2 * (3072 - 2 * t10)) / 1024

/// sin(theta) for small angles via theta - theta^3/6.
/// Q12 in/out; accurate to ~4e-5 for |theta| <= 0.5 rad.
let sinSmall12 (theta12: int) : int =
    let t2 = (theta12 * theta12) / 4096
    let t3 = (t2 * theta12) / 4096
    theta12 - t3 / 6

/// cos(theta) for small angles via 1 - theta^2/2 + theta^4/24.
/// Q12 in/out; accurate to ~2e-5 for |theta| <= 0.5 rad.
let cosSmall12 (theta12: int) : int =
    let t2 = (theta12 * theta12) / 4096
    let t4 = (t2 * t2) / 4096
    4096 - t2 / 2 + t4 / 24
