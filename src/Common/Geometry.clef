/// Common.Geometry — the transform, light and shading maths
///
/// One definition, compiled into both binaries. The CPU rasteriser calls
/// these to shade sprite impostors; the GPU kernel calls the same
/// functions per pixel inside a device code object. Everything here is
/// pure integer arithmetic over scalars — no buffers, no state — which is
/// exactly why it can cross to the device unchanged: a nativeptr
/// parameter would arrive as a bare `index` with no extent and no address
/// space, and the ROCDL pipeline could not legalise it.
module Common.Geometry

open Common.Fixed

// Light: point source at (0, 0, -75) logo units, Q2 units (unit * 4),
// reference d^2 = 235808 at the glyph centre. One source, and both halves
// of the shading agree about it — lightAt takes its distance, shadeNormal
// takes its direction, and neither approximates it as a distant light.
// Perspective: F8 = 66560, pivot axis PX8 = 17423, camera axis PY8 = 17152,
// logo-unit -> screen scale K12, supplied per frame rather than fixed, so
// the glyph can be sized to the slot the splash composition reserves.

/// Intensity at a point, Q12 (4096 = 1.0). Same law as Gfx3D.Scene.lightAt.
let lightAt (px8: int) (py8: int) (pz8: int) : int =
    let dx = px8 / 64
    let dy = py8 / 64
    let dz = pz8 / 64 + 300
    let d2 = dx * dx + dy * dy + dz * dz
    let i10 = if d2 > 0 then (235808 * 1024) / d2 else 1024
    i10 * 4

/// Rotate and project one sphere. Returns the Q8 screen x of the centre.
let projX8 (x8: int) (ct: int) (st: int) (ox8: int) (k12: int) : int =
    let rx8 = x8 - 17423
    let xr8 = (rx8 * ct) / 4096
    let zr8 = (rx8 * st) / 4096
    let s12 = (66560 * 4096) / (66560 + zr8)
    let px8 = 17423 + (xr8 * s12) / 4096
    ox8 + (k12 * px8) / 4096

/// Q8 screen y of the projected centre.
let projY8 (x8: int) (y8: int) (st: int) (oy8: int) (k12: int) : int =
    let rx8 = x8 - 17423
    let zr8 = (rx8 * st) / 4096
    let s12 = (66560 * 4096) / (66560 + zr8)
    let py8 = 17152 + ((y8 - 17152) * s12) / 4096
    oy8 + (k12 * py8) / 4096

/// Q8 screen radius after perspective.
let projR8 (x8: int) (r8: int) (st: int) (k12: int) : int =
    let rx8 = x8 - 17423
    let zr8 = (rx8 * st) / 4096
    let s12 = (66560 * 4096) / (66560 + zr8)
    (((r8 * k12) / 4096) * s12) / 4096

/// Colour for a surface whose normal is (nx, ny, nz) in Q12, lit at the
/// logo-space position (lx8, ly8, pz8). Packed 0xRRGGBB.
///
/// The normal is a parameter rather than being derived from one sphere,
/// because the glyph is a union of overlapping spheres and the visible
/// surface where two of them meet belongs to neither. Taking the nearest
/// sphere's own normal there puts a crease along every intersection
/// circle — visible as ridging along the swoop and as a hard lens-shaped
/// seam where the chain enters the ball.
/// `sh12` is the fraction of the key light reaching this point (Q12): 4096
/// fully lit, 0 fully occluded. It attenuates the DIRECTIONAL terms only.
///
/// A specular highlight is a mirror image of the source, so a point that
/// cannot see the source has no highlight — not a dimmed one, none. Scaling
/// the finished colour instead leaves a saturated glint at whatever the
/// ambient floor is (here 737/4096, which passes a 255 highlight through at
/// 76) and the body reads as lit from inside its own shadow. The ambient
/// term is the one thing that survives, because it is by definition the
/// light that did not come from the source.
let shadeNormal (nx: int) (ny: int) (nz: int)
                (lx8: int) (ly8: int) (pz8: int) (sh12: int) : int =
    // Direction to the light, per shaded point. This used to be two frozen
    // constants — (-1562,-1726,3370) and (-818,-904,3910) — which are
    // exactly the light and half vectors for the point source at logo
    // (0, 0, -75), evaluated once at the glyph centre. That made the model
    // inconsistent with itself: lightAt already treats the source as a
    // point and falls off with distance, while the direction was fixed as
    // though the source were at infinity.
    //
    // Everything near the bulb is unaffected, because that is where the
    // constants were fitted. The parts that were wrong are the ones far
    // from it: the two dots sit at logo x ~ 110 against the bulb's ~ 38, so
    // their true light vector is (-0.755, -0.409, 0.512) rather than
    // (-0.381, -0.421, 0.823). Lit by the frozen pair they carried the
    // bulb's highlight in the bulb's position, identically on both dots;
    // lit properly the highlights swing toward the light and sit
    // differently on each, because each is a different distance from it.
    //
    // The light sits at logo (0, 0, -75); -75 logo units is -19200 in Q8,
    // and nz > 0 faces the viewer, so the depth term is pz8 + 19200.
    let ux = 0 - lx8
    let uy = 0 - ly8
    let uz = pz8 + 19200
    let ul = Fixed.isqrt (ux * ux + uy * uy + uz * uz)
    let lxu = if ul > 0 then (ux * 4096) / ul else 0
    let lyu = if ul > 0 then (uy * 4096) / ul else 0
    let lzu = if ul > 0 then (uz * 4096) / ul else 4096
    // Blinn half vector against the view direction, which is (0, 0, 1) in
    // this convention because the shading frame already faces the viewer.
    let hz0 = lzu + 4096
    let hl = Fixed.isqrt (lxu * lxu + lyu * lyu + hz0 * hz0)
    let hxu = if hl > 0 then (lxu * 4096) / hl else 0
    let hyu = if hl > 0 then (lyu * 4096) / hl else 0
    let hzu = if hl > 0 then (hz0 * 4096) / hl else 4096
    let ndl = Fixed.clamp ((nx * lxu + ny * lyu + nz * lzu) / 4096) 0 4096
    let ndh = Fixed.clamp ((nx * hxu + ny * hyu + nz * hzu) / 4096) 0 4096
    let p2 = (ndh * ndh) / 4096
    let p4 = (p2 * p2) / 4096
    let p8v = (p4 * p4) / 4096
    let p16 = (p8v * p8v) / 4096
    let p32 = (p16 * p16) / 4096
    let p64 = (p32 * p32) / 4096
    // A tighter lobe. At ^40 the highlight saturated all three channels
    // across a wide patch, which reads as a washed-out translucency rather
    // than a polished surface.
    let spec = (p64 * p8v) / 4096
    // 737 is the ambient floor and is NOT shadowed; 3359*ndl is the key
    // light's diffuse share and is. The specular is extinguished outright.
    let lit = 737 + (3359 * ((ndl * sh12) / 4096)) / 4096
    let glint = (216 * ((3400 * ((spec * sh12) / 4096)) / 4096)) / 4096
    let inten = lightAt lx8 ly8 pz8
    // Base albedo, Braidpoint orange #ec6911 (236, 105, 17).
    //
    // The old triple was (68, 38, 26) — a ratio of 1 : 0.56 : 0.38. The blue
    // term is what made it read as brown rather than as a warm colour: at
    // better than a third of the red it desaturates the hue toward grey
    // before the light ever touches it. The brand orange is 1 : 0.45 : 0.07,
    // the same family with the mud taken out.
    //
    // The magnitudes are scaled so the bulb reaches roughly the brand colour
    // where it faces the light. Intensity still falls off with distance, so
    // the dots and the tail sit darker than the bulb — that is the point
    // light doing its job, not a colour choice. Highlights clip to white via
    // glint, which is what makes the surface read as polished.
    let cr = Fixed.clamp ((((137 * lit) / 4096 + glint) * inten) / 4096) 0 255
    let cg = Fixed.clamp (((( 61 * lit) / 4096 + glint) * inten) / 4096) 0 255
    let cb = Fixed.clamp (((( 10 * lit) / 4096 + glint) * inten) / 4096) 0 255
    cr * 65536 + cg * 256 + cb
