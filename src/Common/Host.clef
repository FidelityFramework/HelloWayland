/// Common.Host — the substrate-neutral application shell
///
/// Window, GBM swapchain, frame-callback pacing, resize handling and
/// DMA-BUF presentation: identical for every substrate, compiled once.
/// The only thing it does not know is how a frame gets painted — that is
/// `Fill`, and which implementation of `Fill` is compiled is decided by
/// the fidproj:
///
///   HelloWayland.fidproj      -> src/Cpu/Fill.clef   (links no ROCm)
///   HelloWayland.GPU.fidproj  -> src/Gpu/Fill.clef   (loads a code object)
///
/// So the two binaries differ by one file in a source list. Everything
/// above the fill contract — including the animation curve in Common.Anim
/// and the geometry in Common.Model — is one definition.
///
/// The blocking wl_display_dispatch is the frame throttle: the compositor
/// fires frame-done at its refresh rate, so the animation matches the
/// display without timers, and occlusion pauses it for free.
///
module Common.Host

open Console
open Fidelity.Wayland.Core
open Fidelity.Wayland.Core.Api
open Fidelity.Wayland.Bridge.Protocol
open Fidelity.Wayland.Bridge.XdgShell
open Fidelity.Wayland.Bridge.DmaBuf
open Fidelity.Wayland.Bridge.Callbacks
open Platform.Display.Connection
open Platform.Display.Surface
open Platform.Display.Graphics
open Platform.Display.Svg
open Platform.Display.Compositing
open Common.Fixed
open Common.Model
open Common.Anim
open Common.Trace

/// wl_callback::done handler for wl_surface::frame — the animation clock.
/// data points to 2 uint32 slots: [0] = frame-ready flag, [1] = timestamp ms.
/// Resolved at runtime via dlsym as "Common.Host.frameDone";
/// the one-shot callback proxy is destroyed here and re-requested per frame.
let frameDone (data: nativeint) (callback: nativeint) (callbackData: uint32) : unit =
    wl_proxy_destroy (Some callback)
    let slots = NativePtr.ofNativeInt<uint32> data
    NativePtr.set slots 0 (uint32 1)
    NativePtr.set slots 1 callbackData

/// xdg_toplevel::configure handler — records the compositor-assigned
/// window size (0 means "no preference"). data is the shared state
/// buffer; width/height land in int32 slots 2 and 3.
/// Resolved via dlsym as "Common.Host.toplevelConfigure".
let toplevelConfigure (data: nativeint) (toplevel: nativeint)
                      (width: int32) (height: int32)
                      (states: nativeint) : unit =
    let slots = NativePtr.ofNativeInt<int32> data
    NativePtr.set slots 2 width
    NativePtr.set slots 3 height

/// Create an xdg toplevel like Surface.createToplevel, but with the
/// configure handler above so resizes reach the app. Ping, ack, and
/// close reuse the framework callback symbols; statePtr doubles as the
/// close-flag slot and the configure size store.
let createAnimatedToplevel (display: nativeint) (compositor: nativeint)
                           (xdgWmBase: nativeint) (statePtr: nativeint)
                           (title: string) : option<nativeint> =
    let wmBaseListener = buildXdgWmBaseListener
                            "Platform.Display.Callbacks.wmBasePing"
    wl_proxy_add_listener (Some xdgWmBase) (nativeint &wmBaseListener) (Some 0n) |> ignore

    match wl_compositor_create_surface compositor with
    | None ->
        Console.writeln "Host: failed to create surface"
        None
    | Some surf ->

    match xdg_wm_base_get_xdg_surface xdgWmBase surf with
    | None ->
        Console.writeln "Host: failed to get xdg_surface"
        None
    | Some xdgSurf ->

    let xdgSurfaceListener = buildXdgSurfaceListener
                                "Platform.Display.Callbacks.surfaceConfigure"
    wl_proxy_add_listener (Some xdgSurf) (nativeint &xdgSurfaceListener) (Some 0n) |> ignore

    match xdg_surface_get_toplevel xdgSurf with
    | None ->
        Console.writeln "Host: failed to get toplevel"
        None
    | Some tl ->

    let toplevelListener = buildXdgToplevelListener
                            "Common.Host.toplevelConfigure"
                            "Platform.Display.Callbacks.toplevelClose"
                            "Platform.Display.Callbacks.toplevelConfigureBounds"
                            "Platform.Display.Callbacks.toplevelWmCapabilities"
    wl_proxy_add_listener (Some tl) (nativeint &toplevelListener) (Some statePtr) |> ignore

    let titlePtr = nativeint title.Pointer
    let appIdPtr = nativeint "com.speakez.fidelity".Pointer
    xdg_toplevel_set_title tl titlePtr
    xdg_toplevel_set_app_id tl appIdPtr

    // initial commit triggers the first configure with the assigned size
    wl_surface_commit surf
    wl_display_roundtrip (Some display) |> ignore

    Some surf

/// Create a reusable wl_buffer for an exported DMA-BUF fd.
/// Unlike Surface.presentDmaBuf this neither attaches nor commits —
/// the returned wl_buffer is created once per swapchain build and
/// re-attached every frame.
let createWlBuffer (dmabuf: nativeint) (fd: int) (width: int) (height: int)
                   (stride: int) (format: uint32) : nativeint =
    match zwp_linux_dmabuf_v1_create_params dmabuf with
    | None -> 0n
    | Some bufParams ->
    zwp_linux_buffer_params_v1_add bufParams (int32 fd)
        (uint32 0) (uint32 0) (uint32 stride) (uint32 0) (uint32 0)
    match zwp_linux_buffer_params_v1_create_immed bufParams
                    (int32 width) (int32 height) format (uint32 0) with
    | None ->
        zwp_linux_buffer_params_v1_destroy bufParams
        0n
    | Some buffer ->
        zwp_linux_buffer_params_v1_destroy bufParams
        buffer

/// Release a resource slot if it holds one.
///
/// Nine sites in rebuildSwapchain teardown spelled this out as
/// `if p <> 0n then destroy p else ()`, which is nine copies of a guard and
/// nine chances to write the wrong one. As a combinator the guard exists
/// once and each site says only *what* it releases. Higher-order functions
/// lower fine — Composer's 12_HigherOrderFunctions sample is the proof.
let private releaseIf (p: nativeint) (destroy: nativeint -> unit) : unit =
    if p <> 0n then destroy p else ()

/// Same, for a file descriptor, where the empty value is 0 rather than 0n.
let private closeIf (fd: int) : unit =
    if fd > 0 then Fidelity.Libc.IO.close fd |> ignore else ()

/// (Re)build the swapchain and static per-size data for window (w, h).
/// handles = 10 nativeint slots, zero-initialized before the first call:
///   [0] bo0  [1] bo1  [2] wlBuf0  [3] wlBuf1
///   [6] map stride (as nativeint)  [7] fd0  [8] fd1
///   [12] the substrate's Fill state block
/// Existing entries are destroyed first. ctx receives the window size,
/// glyph origin, zbuf stride, and clip rect. Returns 0 on success.
let rebuildSwapchain (splashPix: nativeint) (device: nativeint) (dmabuf: nativeint)
                     (samples: nativeptr<int32>) (count: int)
                     (strideStorage: nativeint) (mapDataStorage: nativeint)
                     (ctx: nativeptr<int32>) (handles: nativeptr<nativeint>)
                     (w: int) (h: int) : int =
    // tear down the previous size, if any
    // What this window size owned, released. The guard lives in releaseIf,
    // so each line names a resource and its destructor and nothing else.
    let freeMem (p: nativeint) : unit = Fidelity.Libc.Memory.free (Some p) |> ignore
    releaseIf (NativePtr.get handles 2) wl_buffer_destroy      // wl_buffer 0
    releaseIf (NativePtr.get handles 3) wl_buffer_destroy      // wl_buffer 1
    releaseIf (NativePtr.get handles 0) Graphics.destroyBuffer // gbm bo 0
    releaseIf (NativePtr.get handles 1) Graphics.destroyBuffer // gbm bo 1
    closeIf   (int (NativePtr.get handles 7))                  // dmabuf fd 0
    closeIf   (int (NativePtr.get handles 8))                  // dmabuf fd 1
    releaseIf (NativePtr.get handles 4) freeMem                // backdrop
    releaseIf (NativePtr.get handles 5) freeMem                // zbuf
    releaseIf (NativePtr.get handles 10) freeMem               // staging

    let bo0 = Graphics.allocateRgbaBuffer device w h
    let bo1 = Graphics.allocateRgbaBuffer device w h
    if bo0 = 0n || bo1 = 0n then 1
    else
    // learn the CPU-map stride (may exceed w*4) from a first map of each bo
    NativePtr.write (NativePtr.ofNativeInt<nativeint> mapDataStorage) 0n
    let mapped0 = Graphics.mapBufferWrite bo0 w h strideStorage mapDataStorage
    if mapped0 = 0n then 1
    else
    let stride = int (NativePtr.read (NativePtr.ofNativeInt<uint32> strideStorage))
    let mapData0 = NativePtr.read (NativePtr.ofNativeInt<nativeint> mapDataStorage)
    Graphics.unmapBuffer bo0 mapData0
    NativePtr.write (NativePtr.ofNativeInt<nativeint> mapDataStorage) 0n
    let mapped1 = Graphics.mapBufferWrite bo1 w h strideStorage mapDataStorage
    if mapped1 = 0n then 1
    else
    let stride1 = int (NativePtr.read (NativePtr.ofNativeInt<uint32> strideStorage))
    let mapData1 = NativePtr.read (NativePtr.ofNativeInt<nativeint> mapDataStorage)
    Graphics.unmapBuffer bo1 mapData1
    if stride1 <> stride then
        Console.writeln "Host: swapchain buffers map with different strides"
        1
    else

    // Window-size context. Where the glyph sits and how far it reaches are
    // properties of the model and the window, not of the substrate, so the
    // shell settles them before either Fill sees the frame.
    NativePtr.set ctx 4 (int32 w)
    NativePtr.set ctx 5 (int32 h)
    NativePtr.set ctx 10 (int32 (Graphics.getBufferFd bo0))
    NativePtr.set ctx 11 (int32 (Graphics.getBufferFd bo1))
    // Centre the glyph from the model's own extent. This used to be a
    // literal 460x700 pixel box with two Q8 nudges, measured off one
    // particular build — so it drifted the moment the model changed, and
    // the model has since changed shape twice (the tube became cone
    // endpoints, and the samples fully contained in the bulb were dropped).
    // Deriving the box means the glyph stays centred whatever the chain
    // does next.
    let mutable gx0 = 2000000000
    let mutable gx1 = 0 - 2000000000
    let mutable gy0 = 2000000000
    let mutable gy1 = 0 - 2000000000
    let mutable m = 0
    while m < count do
        let mx8 = int (NativePtr.get samples (m * 4 + 0))
        let my8 = int (NativePtr.get samples (m * 4 + 1))
        let mr8 = int (NativePtr.get samples (m * 4 + 2))
        if mx8 - mr8 < gx0 then gx0 <- mx8 - mr8 else ()
        if mx8 + mr8 > gx1 then gx1 <- mx8 + mr8 else ()
        if my8 - mr8 < gy0 then gy0 <- my8 - mr8 else ()
        if my8 + mr8 > gy1 then gy1 <- my8 + mr8 else ()
        m <- m + 1
    // Size and place the glyph inside the slot the splash reserves for it.
    //
    // The composition is 460x700 and holds the wordmark at y~355-465 and the
    // spec panel at y~485-665, so everything above y~350 is the glyph's. The
    // scale used to be the constant 13759/4096, which rendered the model at a
    // fixed 401x441 px whatever the window did — taller than the 330 px slot,
    // which is why the glyph overran the composition instead of sitting in it.
    //
    // screen_px = k12 * logoQ8 / (4096 * 256), so the k12 that makes the model
    // exactly fill a span is span * 4096 * 256 / extent; take the smaller of
    // the two axes to fit rather than crop, and keep a tenth back as margin.
    // The composition is 460x700 and holds the wordmark at y~355-465 and the
    // spec panel at y~485-665, so everything above y~350 is the glyph's.
    //
    // screen_px = k12 * logoQ8 / (4096 * 256), so the k12 that makes the model
    // exactly fill a span is span * 4096 * 256 / extent; take the smaller of
    // the two axes to fit rather than crop, and keep a tenth back as margin.
    let splashX = (w - 460) / 2
    let splashY = (h - 700) / 2
    // The substrate tag now sits beside the wordmark rather than above the
    // glyph, so the whole top of the composition is the glyph's again — and
    // the logo is the thing that should carry it.
    let slotY = 6
    let slotW = 460
    // Bottom at 330, clear of the wordmark's 358. The margin matters because
    // boundsOf pads the model's box by the perspective sweep (rp8/6 +
    // dxa8/6) and the tracer paints its background across the whole padded
    // rect — so a slot that merely fits the glyph still writes black over
    // type the glyph never reaches. Measured, not guessed: at slot height
    // 330 the wordmark lost 14 rows, at 314 it lost 3.
    let slotH = 330
    let ext8x = if gx1 > gx0 then gx1 - gx0 else 1
    let ext8y = if gy1 > gy0 then gy1 - gy0 else 1
    let kx = (slotW * 4096 * 256) / ext8x
    let ky = (slotH * 4096 * 256) / ext8y
    let kFit = if kx < ky then kx else ky
    let k12 = (kFit * 9) / 10
    NativePtr.set ctx 13 (int32 k12)
    // Centre the model's box on the slot's centre, in the splash's frame.
    let cxPx = splashX + slotW / 2
    let cyPx = splashY + slotY + slotH / 2
    NativePtr.set ctx 6 (int32 (cxPx * 256 - (k12 * ((gx0 + gx1) / 2)) / 4096))
    NativePtr.set ctx 7 (int32 (cyPx * 256 - (k12 * ((gy0 + gy1) / 2)) / 4096))
    NativePtr.set ctx 8 (int32 w)
    // Conservative glyph bound: the tracer's sweep rect and the damage
    // region the shell reports to the compositor are the same rectangle.
    Anim.boundsOf samples count ctx (int (NativePtr.get ctx 13))
    NativePtr.set ctx 0 (int32 (Fixed.clamp (int (NativePtr.get ctx 0)) 0 w))
    NativePtr.set ctx 1 (int32 (Fixed.clamp (int (NativePtr.get ctx 1)) 0 h))
    NativePtr.set ctx 2 (int32 (Fixed.clamp (int (NativePtr.get ctx 2)) 0 w))
    NativePtr.set ctx 3 (int32 (Fixed.clamp (int (NativePtr.get ctx 3)) 0 h))
    // A fresh swapchain has two buffers of undefined content, so the next
    // two frames paint the whole window; after that only the glyph's rows
    // change and the rest of each buffer is already correct.
    // No full-window repaints. The swapchain buffers are seeded with the
    // chrome just below, and a full paint would have the tracer overwrite
    // every pixel with its own background — erasing exactly what was seeded.
    // The band is the glyph's rect from the first frame onward.
    NativePtr.set ctx 12 (int32 0)
    // Then hand off: Fill owns only whatever resources its strategy needs.
    if Fill.resize samples count ctx (NativePtr.ofNativeInt<nativeint> (NativePtr.get handles 12)) w h stride <> 0 then 1
    else

    let format = Graphics.getBufferFormat bo0
    let fd0 = Graphics.getBufferFd bo0
    let fd1 = Graphics.getBufferFd bo1
    let wlBuf0 = createWlBuffer dmabuf fd0 w h (Graphics.getBufferStride bo0) format
    let wlBuf1 = createWlBuffer dmabuf fd1 w h (Graphics.getBufferStride bo1) format
    if wlBuf0 = 0n || wlBuf1 = 0n then
        Console.writeln "Host: failed to create wl_buffers"
        1
    else
    NativePtr.set handles 0 bo0
    NativePtr.set handles 1 bo1
    NativePtr.set handles 2 wlBuf0
    NativePtr.set handles 3 wlBuf1
    // Static backdrop, painted once per window size: solid ground with the
    // splash composited at its natural 460x700 into the middle. The tracer
    // still owns its band, so this shows through everywhere the glyph's rows
    // are not — which is exactly the seam the next step closes by having
    // Trace.pixel sample this buffer instead of returning a constant.
    let backdropBytes = stride * h
    let backdrop =
        match Fidelity.Libc.Memory.malloc (unativeint backdropBytes) with
        | Some v -> v
        | None -> 0n
    if backdrop = 0n then 1
    else
    Compositing.paintSolidColor backdrop w h stride 0 0 0
    if splashPix <> 0n then
        Compositing.compositeOver backdrop w h stride splashPix 460 700
                                  ((w - 460) / 2) ((h - 700) / 2)
    else
        ()
    NativePtr.set handles 4 backdrop
    // Seed both swapchain buffers with the chrome, once. The splash has no
    // background of its own — the only rect is the translucent panel — so it
    // is transparent artwork over black, and the tracer's own black inside
    // its band is already the right colour there.
    //
    // This is why nothing has to be composited per frame: with the glyph now
    // scaled into the slot the composition reserves (y ~18-348), its band no
    // longer reaches the wordmark at 355 or the panel at 485. The band and
    // the chrome are disjoint, so each can own its pixels outright. It also
    // works on both substrates, where per-frame compositing did not: the GPU
    // kernel writes the scanout buffer directly and stores every pixel, so it
    // could never have skipped a miss to let a backdrop show through.
    let mutable seed = 0
    while seed < 2 do
        let sbo = if seed = 0 then bo0 else bo1
        NativePtr.write (NativePtr.ofNativeInt<nativeint> mapDataStorage) 0n
        let sm = Graphics.mapBufferWrite sbo w h strideStorage mapDataStorage
        if sm <> 0n then
            Fidelity.Libc.Memory.memcpy (Some sm) (Some backdrop) (unativeint backdropBytes) |> ignore
            Graphics.unmapBuffer sbo (NativePtr.read (NativePtr.ofNativeInt<nativeint> mapDataStorage))
        else ()
        seed <- seed + 1
    NativePtr.set handles 6 (nativeint stride)
    NativePtr.set handles 7 (nativeint fd0)
    NativePtr.set handles 8 (nativeint fd1)
    // Publish the swapchain fds so a substrate that can address the
    // scanout buffer directly (unified memory) may import them.
    NativePtr.set ctx 10 (int32 fd0)
    NativePtr.set ctx 11 (int32 fd1)
    0

/// Map the back buffer, let the substrate paint it, unmap.
/// The shell never touches a pixel.
let renderInto (bo: nativeint) (strideStorage: nativeint) (mapDataStorage: nativeint)
               (handles: nativeptr<nativeint>)
               (samples: nativeptr<int32>) (count: int) (table: int array)
               (ctx: nativeptr<int32>) (theta12: int) : int =
    let w = int (NativePtr.get ctx 4)
    let h = int (NativePtr.get ctx 5)
    let stride = int (NativePtr.get handles 6)
    NativePtr.set ctx 9 (int32 (int (NativePtr.get handles 13)))
    // Which rows this frame has to touch. Only the glyph moves, so after
    // both buffers have had one full paint the band is the glyph's rows.
    let full = int (NativePtr.get ctx 12)
    let ry0 = int (NativePtr.get ctx 1)
    let ry1 = int (NativePtr.get ctx 3)
    let bandY0 = if full > 0 then 0 else ry0
    let bandRows = if full > 0 then h else ry1 - ry0
    if full > 0 then NativePtr.set ctx 12 (int32 (full - 1)) else ()
    // The frame description is substrate-neutral, so the shell builds it.
    Trace.fillTable table samples count (stride / 4) h
                    (int (NativePtr.get ctx 6)) (int (NativePtr.get ctx 7))
                    (Fixed.cosSmall12 theta12) (Fixed.sinSmall12 theta12) w
                    (int (NativePtr.get ctx 0)) (int (NativePtr.get ctx 1))
                    (int (NativePtr.get ctx 2)) (int (NativePtr.get ctx 3))
                    bandY0 bandRows (Model.anchorCount ())
                    (int (NativePtr.get ctx 13))
    if Fill.wantsCpuMapping () = 0 then
        // The substrate addresses the buffer itself; mapping it here would
        // stage a CPU copy over the top of the device's own writes.
        Fill.frame table ctx
                   (NativePtr.ofNativeInt<nativeint> (NativePtr.get handles 12))
                   0n stride
    else
    // gbm_bo_map requires *map_data == NULL on entry (Mesa contract)
    NativePtr.write (NativePtr.ofNativeInt<nativeint> mapDataStorage) 0n
    let mapped = Graphics.mapBufferWrite bo w h strideStorage mapDataStorage
    if mapped = 0n then 1
    else
    let rc = Fill.frame table ctx
                 (NativePtr.ofNativeInt<nativeint> (NativePtr.get handles 12))
                 mapped stride
    let mapData = NativePtr.read (NativePtr.ofNativeInt<nativeint> mapDataStorage)
    Graphics.unmapBuffer bo mapData
    rc

/// Run the animated splash: responsive window, +-30 deg pivot with a 2 s
/// traverse per swing (4 s period), compositor-paced at the display rate.
let run (title: string) : int =
    let globalsRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 32) with
        | Some v -> v
        | None -> 0n
    if globalsRaw = 0n then 1
    else
    let globals = NativePtr.ofNativeInt<nativeint> globalsRaw
    let disp = Connection.connect globals
    if disp = 0n then
        Console.writeln "Host: failed to connect to display"
        1
    else
    let device = Graphics.createDevice ()
    if device = 0n then
        Console.writeln "Host: failed to create graphics device"
        1
    else
    // shared state: close flag (nativeint slot 0) + configure w/h (int32 2, 3)
    let stateRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 16) with
        | Some v -> v
        | None -> 0n
    if stateRaw = 0n then 1
    else
    let closeFlagPtr = NativePtr.ofNativeInt<nativeint> stateRaw
    let confPtr = NativePtr.ofNativeInt<int32> stateRaw
    NativePtr.set closeFlagPtr 0 0n
    NativePtr.set confPtr 2 (int32 0)
    NativePtr.set confPtr 3 (int32 0)

    let compositor = NativePtr.get globals 1
    let wmBase = NativePtr.get globals 2
    let dmabuf = NativePtr.get globals 3

    match createAnimatedToplevel disp compositor wmBase stateRaw title with
    | None -> 1
    | Some surface ->

    // static allocations shared across window sizes
    let strideStorage =
        match Fidelity.Libc.Memory.malloc (unativeint 4) with
        | Some v -> v
        | None -> 0n
    let mapDataStorage =
        match Fidelity.Libc.Memory.malloc (unativeint 8) with
        | Some v -> v
        | None -> 0n
    // One rasterization for the life of the process, at the composition's
    // natural 460x700. Absolute path for now: the binary runs from targets/.
    let splashPix =
        Svg.rasterizeStyled "/home/hhh/repos/HelloWayland/assets/splash_noglyph.svg"
                            460 700 (Fill.plateCss ())
    if splashPix = 0n then Console.writeln "Host: splash rasterize failed (continuing without it)" else ()

    // 508 points x 4 int32 (x, y, r, k) — the quad stride the model writes.
    let samplesRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 8192) with
        | Some v -> v
        | None -> 0n
    let fillRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 256) with
        | Some v -> v
        | None -> 0n
    let ctxRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 64) with
        | Some v -> v
        | None -> 0n
    let handlesRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 128) with
        | Some v -> v
        | None -> 0n
    let frameSlotsRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 8) with
        | Some v -> v
        | None -> 0n
    if strideStorage = 0n || mapDataStorage = 0n || samplesRaw = 0n || fillRaw = 0n
       || ctxRaw = 0n || handlesRaw = 0n || frameSlotsRaw = 0n then 1
    else
    let _ = Fidelity.Libc.Memory.memset (Some fillRaw) 0 (unativeint 256)
    let _ = Fidelity.Libc.Memory.memset (Some handlesRaw) 0 (unativeint 128)
    let samples = NativePtr.ofNativeInt<int32> samplesRaw
    let ctx = NativePtr.ofNativeInt<int32> ctxRaw
    let handles = NativePtr.ofNativeInt<nativeint> handlesRaw
    let frameSlots = NativePtr.ofNativeInt<uint32> frameSlotsRaw
    NativePtr.set frameSlots 0 (uint32 0)
    NativePtr.set frameSlots 1 (uint32 0)

    let count = Model.build samples
    let table = Array.zeroCreate<int> (Trace.tableSize count)
    if count = 0 then
        Console.writeln "Host: model build failed"
        1
    else
    Console.write "Host: model spheres="
    Console.writeln (Format.int count)

    // initial window size from the first configure (0 = no preference)
    let confW0 = int (NativePtr.get confPtr 2)
    let confH0 = int (NativePtr.get confPtr 3)
    let mutable curW = if confW0 > 0 then Fixed.clamp confW0 480 4096 else 750
    let mutable curH = if confH0 > 0 then Fixed.clamp confH0 720 4096 else 900

    NativePtr.set handles 12 fillRaw
    if rebuildSwapchain splashPix device dmabuf samples count
                        strideStorage mapDataStorage ctx handles curW curH <> 0 then 1
    else
    Console.write "Host: window "
    Console.write (Format.int curW)
    Console.write "x"
    Console.writeln (Format.int curH)

    let frameListener = buildWlCallbackListener "Common.Host.frameDone"

    // frame 0: draw, request the frame callback BEFORE the commit
    if renderInto (NativePtr.get handles 0) strideStorage mapDataStorage handles
                  samples count table ctx (Anim.angleAt 1000) <> 0 then 1
    else
    match wl_surface_frame surface with
    | None ->
        Console.writeln "Host: wl_surface_frame failed"
        1
    | Some cb0 ->
    wl_proxy_add_listener (Some cb0) (nativeint &frameListener) (Some frameSlotsRaw) |> ignore
    wl_surface_attach surface (NativePtr.get handles 2) (int32 0) (int32 0)
    wl_surface_damage_buffer surface (int32 0) (int32 0) (int32 curW) (int32 curH)
    wl_surface_commit surface

    Console.writeln "Host: entering frame loop..."

    let mutable front = 0
    let mutable resized = false
    let mutable latched = false
    let mutable firstMs = 0
    let mutable frames = 0
    let mutable fpsMarkMs = 0
    let mutable running = true
    while running do
        let result = Connection.dispatch disp
        if result < 0 then
            running <- false
        else
        if NativePtr.get closeFlagPtr 0 = 1n then
            running <- false
        else
        if int (NativePtr.get frameSlots 0) = 1 then
            NativePtr.set frameSlots 0 (uint32 0)
            // the uint32 timestamp sign-extends when bit 31 is set (the
            // compositor clock has an undefined base); normalize to
            // [0, 2^32) and wrap the deltas below
            let ms0 = int (NativePtr.get frameSlots 1)
            let ms = if ms0 < 0 then ms0 + 65536 * 65536 else ms0
            if not latched then
                latched <- true
                firstMs <- ms
                fpsMarkMs <- ms
            else
                ()
            let d0 = ms - firstMs
            let elapsed = if d0 < 0 then d0 + 65536 * 65536 else d0
            // 1000 ms phase offset starts the swing at 0 deg moving right
            let theta = Anim.angleAt (elapsed + 1000)

            // apply any compositor resize before drawing this frame
            let confW = int (NativePtr.get confPtr 2)
            let confH = int (NativePtr.get confPtr 3)
            let newW = if confW > 0 then Fixed.clamp confW 480 4096 else curW
            let newH = if confH > 0 then Fixed.clamp confH 720 4096 else curH
            resized <- false
            if newW <> curW || newH <> curH then
                curW <- newW
                curH <- newH
                resized <- true
                if rebuildSwapchain splashPix device dmabuf samples count
                                    strideStorage mapDataStorage ctx handles curW curH <> 0 then
                    running <- false
                else
                    front <- 0
                    Console.write "Host: resized to "
                    Console.write (Format.int curW)
                    Console.write "x"
                    Console.writeln (Format.int curH)
            else
                ()

            if running then
                let back = if resized then 0 else (if front = 0 then 1 else 0)
                NativePtr.set handles 13 (nativeint back)
                let bo = if back = 0 then NativePtr.get handles 0 else NativePtr.get handles 1
                let wlBuf = if back = 0 then NativePtr.get handles 2 else NativePtr.get handles 3
                if renderInto bo strideStorage mapDataStorage handles
                              samples count table ctx theta = 0 then
                    match wl_surface_frame surface with
                    | Some cb ->
                        wl_proxy_add_listener (Some cb) (nativeint &frameListener) (Some frameSlotsRaw) |> ignore
                    | None ->
                        Console.writeln "Host: wl_surface_frame failed"
                        running <- false
                    if running then
                        wl_surface_attach surface wlBuf (int32 0) (int32 0)
                        if resized then
                            wl_surface_damage_buffer surface (int32 0) (int32 0) (int32 curW) (int32 curH)
                        else
                            wl_surface_damage_buffer surface
                                (int32 (int (NativePtr.get ctx 0)))
                                (int32 (int (NativePtr.get ctx 1)))
                                (int32 (int (NativePtr.get ctx 2) - int (NativePtr.get ctx 0)))
                                (int32 (int (NativePtr.get ctx 3) - int (NativePtr.get ctx 1)))
                        wl_surface_commit surface
                        front <- back
                        frames <- frames + 1
                        let dt0 = ms - fpsMarkMs
                        let dt = if dt0 < 0 then dt0 + 65536 * 65536 else dt0
                        if frames % 120 = 0 && dt > 0 then
                            let fps = 120000 / dt
                            fpsMarkMs <- ms
                            Console.write "Host: ~"
                            Console.write (Format.int fps)
                            Console.writeln " fps"
                        else
                            ()
                    else
                        ()
                else
                    running <- false
            else
                ()
        else
            ()

    Fidelity.Libc.Memory.free (Some frameSlotsRaw) |> ignore
    Fidelity.Libc.Memory.free (Some handlesRaw) |> ignore
    Fidelity.Libc.Memory.free (Some ctxRaw) |> ignore
    Fidelity.Libc.Memory.free (Some fillRaw) |> ignore
    Fidelity.Libc.Memory.free (Some samplesRaw) |> ignore
    Fidelity.Libc.Memory.free (Some strideStorage) |> ignore
    Fidelity.Libc.Memory.free (Some mapDataStorage) |> ignore
    Fidelity.Libc.Memory.free (Some stateRaw) |> ignore
    Fidelity.Libc.Memory.free (Some globalsRaw) |> ignore
    Connection.disconnect disp
    0
