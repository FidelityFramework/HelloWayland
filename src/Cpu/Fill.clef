/// Fill (CPU) — the same tracer, walked on the CPU
///
/// One of two files providing `module Fill`; the fidproj chooses which is
/// compiled. This build links no ROCm and never touches a device.
///
/// It has no renderer of its own. Every pixel comes from
/// Common.Trace.pixel — the identical definition the GPU build dispatches
/// inside a code object — walked here in an ordinary loop.
module Fill

open Console
open Common.Fixed
open Common.Trace

let label () : string = "CPU (Common.Trace, walked)"

/// The CPU writes pixels itself, so the shell must map the buffer object.
let wantsCpuMapping () : int = 1

/// Nothing is size-dependent: the tracer reads the geometry from the table.
let resize (samples: nativeptr<int32>) (count: int)
           (ctx: nativeptr<int32>) (fill: nativeptr<nativeint>)
           (w: int) (h: int) (stride: int) : int = 0

/// Walk the same index domain the GPU dispatches over.
let frame (table: int array) (ctx: nativeptr<int32>) (fill: nativeptr<nativeint>)
          (mapped: nativeint) (stride: int) : int =
    let stridePx = Array.get table 0
    // The table names the band of rows this frame touches; everything
    // outside it is already correct in this buffer.
    let out = NativePtr.ofNativeInt<int32> (mapped + nativeint (Array.get table 16 * stride))
    let n = Array.get table 17 * stridePx
    // Every pixel is written, which is what clears the previous frame's glyph
    // from the band. The band lies inside the slot the composition reserves,
    // so the tracer's background is the same black the chrome sits on and the
    // two never overlap.
    let mutable i = 0
    while i < n do
        NativePtr.set out i (int32 (Trace.pixel i table n))
        i <- i + 1
    0
