/// Gfx3D.Scene — per-frame transform and draw of the pivoting glyph
///
/// Rotation about a vertical axis through the glyph center: every sphere
/// center starts in the z=0 plane, so the rotation collapses to
/// x' = X cos(t), z = X sin(t), followed by a gentle perspective divide
/// s = F/(F + z) and the logo->screen affine. One sin/cos pair per
/// frame; per sphere a handful of fixed-point multiplies and a z-tested
/// sprite blit in fixed chain order (visibility comes from the depth
/// buffer, so the draw order — and therefore the tube's overlap
/// appearance — never flips as the swing crosses center). Depth is the
/// sphere's FRONT surface (centre z minus radius), not its centre: with
/// centre depths, nested spheres of different radii tie and overpaint
/// each other, banding a large sphere with the shading rings of the
/// smaller ones inside it.
///
/// Fixed-point constants (Q8 logo units / Q12 scales), computed offline:
///   K12     = 13759  logo-unit -> screen-px scale (3.35899)
///   PX8/PY8 = 17423/17152  pivot axis x / camera axis y (68.06, 67.0)
///   F8      = 66560  perspective distance (260 logo units)
/// The screen origin of logo (0,0) is dynamic (window-size dependent):
///   ox8 = splashOffsetX*256 + 937, oy8 = splashOffsetY*256 + 5759.
module Gfx3D.Scene

open Gfx3D.Fixed
open Gfx3D.Sprite

/// Pivot angle at elapsed ms: smoothstep-eased triangle wave.
/// Full travel between extremes takes 2 s (4 s round trip), amplitude
/// +-30 deg (returns Q12 radians, +-2145).
let angleAt (elapsedMs: int) : int =
    let ph = elapsedMs % 4000
    let t10 = if ph < 2000 then (ph * 1024) / 2000 else ((4000 - ph) * 1024) / 2000
    let e10 = Fixed.smoothstep10 t10
    0 - 2145 + (2 * 2145 * e10) / 1024

// ─────────────────────────────────────────────────────────────
// LIGHT — a point source in scene space
//
// The light sits in FRONT of the glyph plane and off its upper-left, at
// (0, 0, -75) logo units (the viewer is at -z). Distance in z is the
// lever that matters: moving the light sideways only pushes it farther
// away and flattens everything, while bringing it close in front makes
// the inverse-square falloff steep. At this distance intensity spans
// ~6.6x across the body and the glyph's mean brightness still swings
// 1.37x over a half cycle, so the motion reads both as a gradient
// sweeping across the form and as the whole object passing through a
// light field. Intensity falls off
// with the inverse square of the distance from the light to the sphere
// centre, normalised so a sphere at the glyph centre reads 1.0. Because
// each sphere is shaded by its own distance, the parts of the glyph that
// swing away from the light darken while the parts that swing toward it
// brighten — the gradient sweeps across the body through the pivot,
// which a single whole-glyph multiplier cannot express.
//
// Constants are Q2 logo units (unit * 4) to keep d^2 well inside 32-bit
// range: light at (0, 0, -300), reference d^2 = 235808 at the centre.
// ─────────────────────────────────────────────────────────────

/// Intensity at a point, Q12 (4096 = 1.0). Callers pass the sphere's
/// FRONT SURFACE (centre z minus radius), not its centre: sampling
/// centres makes a large sphere and a small one that touch each other
/// read very differently, because the big sphere's centre is far behind
/// its own surface. That mismatch is what made the swoop look welded
/// onto the ball rather than continuous with it — an 18-bank step right
/// at the seam. Sampling the lit surface normalises across radii.
/// Pure function of position — no buffers, no state. This is the shape a
/// device kernel takes, and it is shared verbatim by any substrate.
let lightAt (px8: int) (py8: int) (pz8: int) : int =
    let dx = px8 / 64
    let dy = py8 / 64
    let dz = pz8 / 64 + 300
    let d2 = dx * dx + dy * dy + dz * dz
    let i10 = if d2 > 0 then (235808 * 1024) / d2 else 1024
    i10 * 4

/// Quantise a Q12 intensity to one of 128 LUT banks spanning 0.30..3.30.
let lightBank (i12: int) : int =
    Fixed.clamp (((i12 - 1229) * 128) / 12288) 0 127

/// Fill the 128-bank intensity LUT spanning 0.30..3.30. Bank contents
/// depend only on the bank index, not the frame, so this runs once at
/// startup. lut must have room for 128 * 256 bytes.
let initLightBanks (lut: nativeptr<byte>) : unit =
    let mutable b = 0
    while b < 128 do
        let m12 = 1229 + b * 96
        let bankBase = b * 256
        let mutable v = 0
        while v < 256 do
            NativePtr.set lut (bankBase + v) (byte (Fixed.clamp ((v * m12) / 4096) 0 255))
            v <- v + 1
        b <- b + 1

/// Render the glyph at angle theta12 into a mapped strided ABGR8888
/// buffer. ctx is the shared frame-geometry buffer (int32 slots):
/// [0..3] clip rect, [4] window w, [5] window h, [6] ox8, [7] oy8,
/// [8] zbuf row stride — (ox8, oy8) is the Q8 screen position of the
/// logo origin. samples/count from ClefModel.build; sprites is the
/// 1024-slot lazy sprite table; zbuf a cleared int32 depth buffer;
/// lut the 128-bank intensity table from initLightBanks.
let drawGlyph (dest: nativeint) (destStride: int)
              (zbuf: nativeptr<int32>) (lut: nativeptr<byte>)
              (samples: nativeptr<int32>) (count: int)
              (sprites: nativeptr<nativeint>)
              (ctx: nativeptr<int32>) (theta12: int) : unit =
    let ox8 = int (NativePtr.get ctx 6)
    let oy8 = int (NativePtr.get ctx 7)
    let ct = Fixed.cosSmall12 theta12
    let st = Fixed.sinSmall12 theta12
    let mutable k = 0
    while k < count do
        let x8 = int (NativePtr.get samples (k * 3 + 0))
        let y8 = int (NativePtr.get samples (k * 3 + 1))
        let r8 = int (NativePtr.get samples (k * 3 + 2))
        let rx8 = x8 - 17423
        let xr8 = (rx8 * ct) / 4096
        let zr8 = (rx8 * st) / 4096
        let s12 = (66560 * 4096) / (66560 + zr8)
        let px8 = 17423 + (xr8 * s12) / 4096
        let py8 = 17152 + ((y8 - 17152) * s12) / 4096
        let sx8 = ox8 + (13759 * px8) / 4096
        let sy8 = oy8 + (13759 * py8) / 4096
        let rp8 = (((r8 * 13759) / 4096) * s12) / 4096
        let r2 = Fixed.clamp ((rp8 * 2 + 128) / 256) 4 132
        // per-sphere light: distance from the point source at this
        // sphere's rotated position picks one of the 128 intensity banks
        let bank = lightBank (lightAt px8 py8 (zr8 - r8))
        // half-pixel position: qx/2 is the pixel, qx%2 the sub-pixel phase
        let qx = (sx8 + 64) / 128
        let qy = (sy8 + 64) / 128
        let cx = qx / 2
        let cy = qy / 2
        let phase = (qy % 2) * 2 + qx % 2
        let spr = Sprite.get sprites r2 phase
        if spr <> 0n then
            Sprite.blit dest destStride zbuf lut (bank * 256) ctx (zr8 - r8) spr r2 cx cy
        else
            ()
        k <- k + 1

/// Conservative screen bounding box of the glyph over the whole
/// oscillation. The perspective divide amplifies both the radii and each
/// sphere center's offset from the camera/pivot axes by up to
/// s12max/4096 ~= 1.134 at the +-30 deg extremes, so both get a 16.7%
/// margin (offset/6) on top of fixed padding. Reads the origin from
/// ctx[6..7] and writes the clip rect into ctx[0..3] (window px,
/// unclamped — the caller clamps to the window).
let bounds (samples: nativeptr<int32>) (count: int) (ctx: nativeptr<int32>) : unit =
    let ox8 = int (NativePtr.get ctx 6)
    let oy8 = int (NativePtr.get ctx 7)
    let ax8 = ox8 + (13759 * 17423) / 4096
    let ay8 = oy8 + (13759 * 17152) / 4096
    let mutable minX = 1000000
    let mutable minY = 1000000
    let mutable maxX = 0 - 1000000
    let mutable maxY = 0 - 1000000
    let mutable k = 0
    while k < count do
        let x8 = int (NativePtr.get samples (k * 3 + 0))
        let y8 = int (NativePtr.get samples (k * 3 + 1))
        let r8 = int (NativePtr.get samples (k * 3 + 2))
        let sx8 = ox8 + (13759 * x8) / 4096
        let sy8 = oy8 + (13759 * y8) / 4096
        let rp8 = (r8 * 13759) / 4096
        let ext8 = rp8 + rp8 / 6            // radius * 1.167 perspective margin
        let dxa8 = if sx8 > ax8 then sx8 - ax8 else ax8 - sx8
        let dya8 = if sy8 > ay8 then sy8 - ay8 else ay8 - sy8
        let cx = sx8 / 256
        let cy = sy8 / 256
        let ex = ext8 / 256 + (dxa8 / 6) / 256 + 1
        let ey = ext8 / 256 + (dya8 / 6) / 256 + 1
        if cx - ex < minX then minX <- cx - ex else ()
        if cy - ey < minY then minY <- cy - ey else ()
        if cx + ex > maxX then maxX <- cx + ex else ()
        if cy + ey > maxY then maxY <- cy + ey else ()
        k <- k + 1
    NativePtr.set ctx 0 (int32 (minX - 6))
    NativePtr.set ctx 1 (int32 (minY - 6))
    NativePtr.set ctx 2 (int32 (maxX + 7))
    NativePtr.set ctx 3 (int32 (maxY + 7))
