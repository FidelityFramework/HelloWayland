/// Gfx3D.Sprite — shaded sphere impostors
///
/// A sphere lit by a fixed light looks identical from every rotation,
/// so one baked sprite serves every sphere of a given screen radius.
/// Sprites are keyed by half-pixel radius r2 plus a 2x2 sub-pixel phase
/// (half-pixel center offsets — small spheres would otherwise shimmer as
/// their centers snap to the pixel grid) and baked lazily into a table.
/// Shading is 4x supersampled (2x2 subsamples per pixel), which keeps the
/// antialiased rim and the specular glint continuous as radii and
/// positions change between frames.
///
/// Blitting is z-tested against a per-pixel depth buffer so visibility is
/// geometric and independent of draw order: opaque pixels write color and
/// depth, rim pixels blend without writing depth. The interior remains a
/// plain byte copy — no per-pixel multiplies or divides off the rim.
///
/// Pixel format: ABGR8888 (R,G,B,A byte order), matching the GBM window
/// buffer. Byte reads are masked with &&& 255 (Alex byte->int
/// sign-extension workaround, same as Platform.Display.Compositing).
module Gfx3D.Sprite

open Gfx3D.Fixed

// Single light source, upper-left-front. Q12 components of
// L = normalize(-0.38, -0.42, 0.82) and the Blinn half-vector
// H = normalize(L + view) with view = (0, 0, 1). y points down.
let private lightX12 () : int = 0 - 1562
let private lightY12 () : int = 0 - 1726
let private lightZ12 () : int = 3370
let private halfX12 () : int = 0 - 818
let private halfY12 () : int = 0 - 904
let private halfZ12 () : int = 3910

/// Shade one supersample at Q8 offset (dx8, dy8) from the disc center for
/// radius r8 (Q8 px). Writes cov (0..256) and premultiplied color
/// accumulators into acc (4 int32 slots: r, g, b, cov).
let private accumulate (acc: nativeptr<int32>) (dx8: int) (dy8: int) (r8: int) : unit =
    let d8 = Fixed.isqrt (dx8 * dx8 + dy8 * dy8)
    let cov = Fixed.clamp (r8 + 128 - d8) 0 256
    if cov > 0 then
        let nx = Fixed.clamp ((dx8 * 4096) / r8) (0 - 4096) 4096
        let ny = Fixed.clamp ((dy8 * 4096) / r8) (0 - 4096) 4096
        let nz2 = 16777216 - nx * nx - ny * ny
        let nz = if nz2 > 0 then Fixed.isqrt nz2 else 0
        let ndl = Fixed.clamp ((nx * (lightX12 ()) + ny * (lightY12 ()) + nz * (lightZ12 ())) / 4096) 0 4096
        let ndh = Fixed.clamp ((nx * (halfX12 ()) + ny * (halfY12 ()) + nz * (halfZ12 ())) / 4096) 0 4096
        // specular (N.H)^40 = (N.H)^32 * (N.H)^8 by repeated squaring
        let p2 = (ndh * ndh) / 4096
        let p4 = (p2 * p2) / 4096
        let p8 = (p4 * p4) / 4096
        let p16 = (p8 * p8) / 4096
        let p32 = (p16 * p16) / 4096
        let spec = (p32 * p8) / 4096
        // rust-biased near-black base (68,38,26), ambient 0.18 +
        // diffuse 0.82*N.L, specular strength 0.95. The base stays dark so
        // the per-sphere light modulation (0.3x..3.3x) reads as the object
        // moving through the light rather than as a flat colour change.
        let lit = 737 + (3359 * ndl) / 4096
        let glint = (255 * ((3891 * spec) / 4096)) / 4096
        let cr = Fixed.clamp ((68 * lit) / 4096 + glint) 0 255
        let cg = Fixed.clamp ((38 * lit) / 4096 + glint) 0 255
        let cb = Fixed.clamp ((26 * lit) / 4096 + glint) 0 255
        NativePtr.set acc 0 (int32 (int (NativePtr.get acc 0) + cr * cov))
        NativePtr.set acc 1 (int32 (int (NativePtr.get acc 1) + cg * cov))
        NativePtr.set acc 2 (int32 (int (NativePtr.get acc 2) + cb * cov))
        NativePtr.set acc 3 (int32 (int (NativePtr.get acc 3) + cov))
    else
        ()

/// Bake a shaded sphere sprite for half-pixel radius r2 with the disc
/// center offset by (fx8, fy8) Q8 sub-pixel fractions from pixel s/2.
/// Returns a malloc'd contiguous RGBA buffer of s*s*4 bytes, s = r2 + 4.
let bake (r2: int) (fx8: int) (fy8: int) : nativeint =
    let s = r2 + 4
    let bytes = s * s * 4
    let raw =
        match Fidelity.Libc.Memory.malloc (unativeint bytes) with
        | Some v -> v
        | None -> 0n
    let accRaw =
        match Fidelity.Libc.Memory.malloc (unativeint 16) with
        | Some v -> v
        | None -> 0n
    if raw = 0n || accRaw = 0n then 0n
    else
    let px = NativePtr.ofNativeInt<byte> raw
    let acc = NativePtr.ofNativeInt<int32> accRaw
    let r8 = r2 * 128                       // radius in Q8 pixels
    let c8x = (s / 2) * 256 + fx8           // disc center: blit maps pixel
    let c8y = (s / 2) * 256 + fy8           // s/2 to the target (cx, cy)
    let mutable y = 0
    while y < s do
        let dy8 = y * 256 - c8y
        let mutable x = 0
        while x < s do
            let dx8 = x * 256 - c8x
            NativePtr.set acc 0 (int32 0)
            NativePtr.set acc 1 (int32 0)
            NativePtr.set acc 2 (int32 0)
            NativePtr.set acc 3 (int32 0)
            // 2x2 supersamples at +-0.25 px
            accumulate acc (dx8 - 64) (dy8 - 64) r8
            accumulate acc (dx8 + 64) (dy8 - 64) r8
            accumulate acc (dx8 - 64) (dy8 + 64) r8
            accumulate acc (dx8 + 64) (dy8 + 64) r8
            let covSum = int (NativePtr.get acc 3)
            let off = (y * s + x) * 4
            if covSum = 0 then
                NativePtr.set px (off + 0) (byte 0)
                NativePtr.set px (off + 1) (byte 0)
                NativePtr.set px (off + 2) (byte 0)
                NativePtr.set px (off + 3) (byte 0)
            else
                NativePtr.set px (off + 0) (byte (int (NativePtr.get acc 0) / covSum))
                NativePtr.set px (off + 1) (byte (int (NativePtr.get acc 1) / covSum))
                NativePtr.set px (off + 2) (byte (int (NativePtr.get acc 2) / covSum))
                NativePtr.set px (off + 3) (byte ((covSum * 255) / 1024))
            x <- x + 1
        y <- y + 1
    Fidelity.Libc.Memory.free (Some accRaw)
    raw

/// Fetch (bake on first use) the sprite for half-pixel radius r2
/// (0..255) and phase (0..3 = fy*2+fx half-pixel offsets).
/// table = 1024 zero-initialized nativeint slots, indexed r2*4+phase.
let get (table: nativeptr<nativeint>) (r2: int) (phase: int) : nativeint =
    let slot = r2 * 4 + phase
    let cached = NativePtr.get table slot
    if cached <> 0n then cached
    else
        let fx8 = if phase % 2 = 1 then 128 else 0
        let fy8 = if phase / 2 = 1 then 128 else 0
        let baked = bake r2 fx8 fy8
        NativePtr.set table slot baked
        baked

/// Z-tested alpha-blit of a sprite (size s = r2+4) centered at pixel
/// (cx, cy) with depth zval. ctx carries the frame geometry:
/// [0..3] clip x0,y0,x1,y1 and [8] the zbuf row stride. zbuf is one
/// int32 per window pixel; smaller z is nearer, ties go to the later
/// draw (keeps the fixed chain order stable through center).
/// lut is the 128-bank intensity table (Scene.initLightBanks) and
/// lutBase selects this sphere's bank: sprite colours pass through it,
/// so each sphere brightens or darkens with its own distance from the
/// point light as the glyph pivots.
let blit (dest: nativeint) (destStride: int)
         (zbuf: nativeptr<int32>) (lut: nativeptr<byte>) (lutBase: int)
         (ctx: nativeptr<int32>) (zval: int)
         (spr: nativeint) (r2: int) (cx: int) (cy: int) : unit =
    let clipX0 = int (NativePtr.get ctx 0)
    let clipY0 = int (NativePtr.get ctx 1)
    let clipX1 = int (NativePtr.get ctx 2)
    let clipY1 = int (NativePtr.get ctx 3)
    let zw = int (NativePtr.get ctx 8)
    let s = r2 + 4
    let destPx = NativePtr.ofNativeInt<byte> dest
    let srcPx = NativePtr.ofNativeInt<byte> spr
    let x0 = cx - s / 2
    let y0 = cy - s / 2
    let zv = int32 zval
    let mutable sy = 0
    while sy < s do
        let dy = y0 + sy
        if dy >= clipY0 && dy < clipY1 then
            let rowBase = dy * destStride
            let zRow = dy * zw
            let srcRow = sy * s
            let mutable sx = 0
            while sx < s do
                let dx = x0 + sx
                if dx >= clipX0 && dx < clipX1 then
                    let srcOff = (srcRow + sx) * 4
                    let sa = int (NativePtr.get srcPx (srcOff + 3)) &&& 255
                    if sa = 255 then
                        if zval <= int (NativePtr.get zbuf (zRow + dx)) then
                            let dstOff = rowBase + dx * 4
                            NativePtr.set destPx (dstOff + 0) (NativePtr.get lut (lutBase + int (NativePtr.get srcPx (srcOff + 0)) &&& 255))
                            NativePtr.set destPx (dstOff + 1) (NativePtr.get lut (lutBase + int (NativePtr.get srcPx (srcOff + 1)) &&& 255))
                            NativePtr.set destPx (dstOff + 2) (NativePtr.get lut (lutBase + int (NativePtr.get srcPx (srcOff + 2)) &&& 255))
                            NativePtr.set destPx (dstOff + 3) (byte 255)
                            NativePtr.set zbuf (zRow + dx) zv
                        else
                            ()
                    else if sa > 0 then
                        if zval <= int (NativePtr.get zbuf (zRow + dx)) then
                            let dstOff = rowBase + dx * 4
                            let inv = 255 - sa
                            let sr = int (NativePtr.get lut (lutBase + int (NativePtr.get srcPx (srcOff + 0)) &&& 255)) &&& 255
                            let sg = int (NativePtr.get lut (lutBase + int (NativePtr.get srcPx (srcOff + 1)) &&& 255)) &&& 255
                            let sb = int (NativePtr.get lut (lutBase + int (NativePtr.get srcPx (srcOff + 2)) &&& 255)) &&& 255
                            let dr = int (NativePtr.get destPx (dstOff + 0)) &&& 255
                            let dg = int (NativePtr.get destPx (dstOff + 1)) &&& 255
                            let db = int (NativePtr.get destPx (dstOff + 2)) &&& 255
                            NativePtr.set destPx (dstOff + 0) (byte ((sr * sa + dr * inv) / 255))
                            NativePtr.set destPx (dstOff + 1) (byte ((sg * sa + dg * inv) / 255))
                            NativePtr.set destPx (dstOff + 2) (byte ((sb * sa + db * inv) / 255))
                            NativePtr.set destPx (dstOff + 3) (byte 255)
                        else
                            ()
                    else
                        ()
                else
                    ()
                sx <- sx + 1
        else
            ()
        sy <- sy + 1
