/// Entry point for the kernel compilation unit.
///
/// Composer tree-shakes to what is reachable from main, so this anchors
/// the kernel functions in the emitted MLIR. The GPU backend leg then
/// takes its own call-graph closure from the kernel entry, so main and
/// anything else host-side never reaches the device code object.
module KernelMain

open Common.Fixed
open Common.Geometry
open Gpu.Kernel

[<EntryPoint>]
let main _ =
    // Reference every function that must survive tree shaking.
    let a = Geometry.projX8 9830 4096 0 38057
    let b = Geometry.projY8 9830 9830 0 31359
    let c = Geometry.projR8 9830 4237 0
    let d = Geometry.frontZ8 9830 4237 0
    let e = Geometry.lightAt 9830 9830 0
    let f = Geometry.hitShade (a + 100) (b + 50) a b c d
    let tbl = Array.zeroCreate<int> 16
    Array.set tbl 0 4
    let g = Kernel.kernel 0 tbl 4
    a + b + c + d + e + f + g
