/// HelloWayland — Clef + Fidelity Native Wayland Splash Screen
///
/// Animated-logo edition: the clef glyph is modeled as 3D geometry
/// (swept-sphere chain + dot spheres, single-light shading) and pivots
/// +-20 deg about its vertical axis, re-rendered every compositor frame
/// via wl_surface::frame callbacks. See docs/animated_logo_3d.md.
module HelloWayland

open Console

[<EntryPoint>]
let main _ =
    Console.writeln "HelloWayland: Fidelity.UI Splash (animated 3D logo)"
    HelloWaylandAnimate.run "HelloWayland"
