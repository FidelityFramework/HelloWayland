/// CPU-HelloWayland — the software-rasterised edition.
///
/// Runs entirely on the CPU: no device, no ROCm linkage, no code object.
/// Identical window, animation and presentation to GPU-HelloWayland,
/// because both call the same Common.Host shell — the fidproj decides
/// which Fill implementation answers.
module Main

open Console

[<EntryPoint>]
let main _ =
    Console.writeln "CPU-HelloWayland: software rasteriser"
    Console.write "  fill: "
    Console.writeln (Fill.label ())
    Common.Host.run "CPU-HelloWayland"
