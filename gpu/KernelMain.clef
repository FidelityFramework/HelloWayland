/// Entry point for the kernel compilation unit.
///
/// Composer tree-shakes to what is reachable from main, so this forces
/// the kernel functions into the emitted MLIR. The binary it produces is
/// never run — the artefact we want is targets/intermediates/10_output.mlir,
/// which build-kernel.sh wraps in a gpu.module and lowers to gfx1151.
module KernelMain

open Console
open Gfx3D.Fixed
open Gpu.Kernel

[<EntryPoint>]
let main _ =
    // Reference every function that must survive tree shaking.
    let a = Kernel.projX8 9830 4096 0 38057
    let b = Kernel.projY8 9830 9830 0 31359
    let c = Kernel.projR8 9830 4237 0
    let d = Kernel.frontZ8 9830 4237 0
    let e = Kernel.lightAt 9830 9830 0
    let f = Kernel.hitShade (a + 100) (b + 50) a b c d
    Console.write "kernel self-test: "
    Console.writeln (Format.int (a + b + c + d + e + f))
    0
